<% content_for :title, "Edit #{@business.name}" %>
<div class="qm-page" style="max-width: 760px">
  <h1 class="h4 mb-3">Edit shop</h1>
  <div class="card"><div class="card-body">
    <%= permitted_form_with model: @business, url: owner_business_path(@business), method: :patch, local: true do |f| %>
      <% if @business.errors.any? %>
        <div class="alert alert-danger"><ul class="mb-0"><% @business.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
      <% end %>
      <div class="row g-3">
        <div class="col-md-8"><%= f.label :name, class: "form-label" %><%= f.text_field :name, class: "form-control", required: true %></div>
        <div class="col-md-4">
          <%= f.label :business_type, class: "form-label" %>
          <%= f.select :business_type, Business::BUSINESS_TYPES.map { |k, v| [v, k] }, {}, class: "form-select" %>
        </div>
        <div class="col-md-4"><%= f.label :currency, class: "form-label" %><%= f.text_field :currency, class: "form-control" %></div>
        <div class="col-md-4"><%= f.label :phone, class: "form-label" %><%= f.text_field :phone, class: "form-control" %></div>
        <div class="col-md-4"><%= f.label :email, class: "form-label" %><%= f.email_field :email, class: "form-control" %></div>
        <div class="col-md-8"><%= f.label :address, class: "form-label" %><%= f.text_field :address, class: "form-control" %></div>
        <div class="col-md-4"><%= f.label :city, class: "form-label" %><%= f.text_field :city, class: "form-control" %></div>
        <div class="col-12 d-flex gap-2">
          <%= f.submit "Save", class: "btn btn-primary" %>
          <%= permitted_link_to "Cancel", owner_business_path(@business), class: "btn btn-link" %>
        </div>
      </div>
    <% end %>
  </div></div>
</div>
