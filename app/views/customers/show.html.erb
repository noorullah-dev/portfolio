<%= page_header @customer.display_name, subtitle: "#{@customer.phone} · #{@customer.city}", icon: "bi-person" do %>
  <div class="d-flex gap-2">
    <%= permitted_link_to new_sale_path(customer_id: @customer.id), class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>New Sale
    <% end %>
    <% if !owner? && can?("installments.collect") %>
    <%= permitted_link_to installment_collections_path(customer_id: @customer.id), class: "btn btn-outline-primary" do %>
      <i class="bi bi-wallet2 me-1"></i>Collect
    <% end %>
    <% end %>
    <%= permitted_link_to edit_customer_path(@customer), class: "btn btn-outline-secondary" do %>
      <i class="bi bi-pencil me-1"></i>Edit
    <% end %>
  </div>
<% end %>

<div class="row g-3 mb-3">
  <% [
    ["Financed total", money(@customer.financed_total)],
    ["Paid to date", money(@customer.paid_total)],
    ["Balance", money(@customer.balance)],
    ["Overdue", money(@customer.overdue_amount)]
  ].each_with_index do |(label, value), index| %>
    <div class="col-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small"><%= label %></div>
          <div class="fs-5 fw-semibold <%= "text-danger" if index == 3 && @customer.defaulter? %>"><%= value %></div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="card mb-3">
  <div class="card-header bg-white fw-semibold">Sales</div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th>Sale #</th><th>Date</th><th>Vehicle</th><th class="text-end">Total</th><th class="text-end">Down</th><th class="text-end">Monthly</th><th class="text-end">Balance</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% @sales.each do |sale| %>
          <tr>
            <td><%= permitted_link_to sale.sale_no, sale_path(sale), class: "text-decoration-none" %></td>
            <td><%= qm_date(sale.sale_date) %></td>
            <td><%= sale.vehicle_label.presence || "—" %></td>
            <td class="text-end"><%= money(sale.total_amount) %></td>
            <td class="text-end"><%= money(sale.down_payment) %></td>
            <td class="text-end"><%= sale.months.to_i.positive? ? money(sale.monthly_amount) : "—" %></td>
            <td class="text-end"><%= sale.credit_sale? ? money(sale.balance) : "—" %></td>
            <td><%= status_badge(sale.status) %></td>
          </tr>
        <% end %>
        <% if @sales.empty? %>
          <tr><td colspan="8" class="text-center text-muted py-4">No sales yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header bg-white fw-semibold">Outstanding installments</div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light"><tr><th>#</th><th>Due</th><th class="text-end">Amount</th><th class="text-end">Remaining</th><th></th></tr></thead>
          <tbody>
            <% @plans.each do |plan| %>
              <tr class="<%= 'table-warning' if plan.overdue? %>">
                <td><%= plan.installment_no %></td>
                <td><%= qm_date(plan.due_date) %></td>
                <td class="text-end"><%= money(plan.amount) %></td>
                <td class="text-end"><%= money(plan.remaining) %></td>
                <td class="text-end"><%= permitted_button_to "Remind", installment_reminder_path(plan), method: :post, class: "btn btn-sm btn-outline-secondary d-inline-block", form: { class: "d-inline" } %></td>
              </tr>
            <% end %>
            <% if @plans.empty? %>
              <tr><td colspan="5" class="text-center text-muted py-3">Nothing outstanding.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card mb-3">
      <div class="card-header bg-white fw-semibold">Recent payments</div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light"><tr><th>Date</th><th>Mode</th><th>Reference</th><th class="text-end">Amount</th></tr></thead>
          <tbody>
            <% @payments.each do |payment| %>
              <tr>
                <td><%= qm_date(payment.payment_date) %></td>
                <td><%= payment.payment_mode&.name || "—" %></td>
                <td><%= payment.reference.presence || "—" %></td>
                <td class="text-end"><%= money(payment.amount) %></td>
              </tr>
            <% end %>
            <% if @payments.empty? %>
              <tr><td colspan="4" class="text-center text-muted py-3">No payments recorded.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-white fw-semibold">Post dated cheques</div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light"><tr><th>Cheque</th><th>Bank</th><th>Date</th><th class="text-end">Amount</th><th>Status</th></tr></thead>
          <tbody>
            <% @cheques.each do |cheque| %>
              <tr>
                <td><%= cheque.cheque_no %></td>
                <td><%= cheque.bank_name.presence || "—" %></td>
                <td><%= qm_date(cheque.cheque_date) %></td>
                <td class="text-end"><%= money(cheque.amount) %></td>
                <td><%= status_badge(cheque.status) %></td>
              </tr>
            <% end %>
            <% if @cheques.empty? %>
              <tr><td colspan="5" class="text-center text-muted py-3">No cheques on file.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header bg-white fw-semibold">Reminder history</div>
  <div class="card-body">
    <% if @reminders.empty? %>
      <p class="text-muted mb-0">No reminders sent yet.</p>
    <% else %>
      <ul class="list-unstyled mb-0">
        <% @reminders.each do |reminder| %>
          <li class="border-bottom py-1 small">
            <i class="bi bi-send me-1"></i><%= reminder.channel.humanize %> ·
            <%= l(reminder.sent_at, format: :short) rescue reminder.sent_at %>
            <%= "- #{reminder.remarks}" if reminder.remarks.present? %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<%= permitted_link_to "Back to customers", customers_path, class: "btn btn-light mt-3" %>