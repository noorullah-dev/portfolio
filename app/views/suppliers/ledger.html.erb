<%= page_header "#{@supplier.name} — Ledger", subtitle: "Purchases and payments", icon: "bi-journal-text" do %>
  <div class="d-flex gap-2">
    <%= permitted_link_to "All suppliers", suppliers_path, class: "btn btn-light" %>
    <%= permitted_link_to supplier_path(@supplier), class: "btn btn-outline-secondary" do %><i class="bi bi-person me-1"></i>Supplier<% end %>
  </div>
<% end %>

<div class="row g-3 mb-3">
  <div class="col-6 col-xl-3">
    <div class="card h-100"><div class="card-body">
      <div class="text-muted small">Total purchases</div>
      <div class="fs-5 fw-semibold"><%= money(@supplier.total_purchases) %></div>
    </div></div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card h-100"><div class="card-body">
      <div class="text-muted small">Total paid</div>
      <div class="fs-5 fw-semibold"><%= money(@supplier.total_paid) %></div>
    </div></div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card h-100"><div class="card-body">
      <div class="text-muted small">Balance owed</div>
      <div class="fs-5 fw-semibold"><%= money(@supplier.balance) %></div>
    </div></div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card h-100"><div class="card-body">
      <div class="text-muted small">Ledger closing</div>
      <div class="fs-5 fw-semibold"><%= money(@closing) %></div>
    </div></div>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th>Date</th><th>Type</th><th>Reference</th><th>Particulars</th>
            <th class="text-end">Debit (Paid)</th><th class="text-end">Credit (Owed)</th>
            <th class="text-end">Balance</th></tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <tr>
            <td><%= qm_date(entry[:date]) %></td>
            <td><span class="badge bg-light text-dark"><%= entry[:type] %></span></td>
            <td class="small"><%= entry[:reference].presence || "—" %></td>
            <td class="small"><%= entry[:particulars] %></td>
            <td class="text-end text-success"><%= entry[:debit].positive? ? money(entry[:debit]) : "" %></td>
            <td class="text-end"><%= entry[:credit].positive? ? money(entry[:credit]) : "" %></td>
            <td class="text-end fw-semibold"><%= money(entry[:balance]) %></td>
          </tr>
        <% end %>
        <% if @entries.empty? %>
          <tr><td colspan="7" class="text-center text-muted py-4">No purchase or payment recorded for this supplier.</td></tr>
        <% end %>
      </tbody>
      <tfoot class="table-light">
        <tr>
          <th colspan="4">Totals</th>
          <th class="text-end"><%= money(@totals[:debit]) %></th>
          <th class="text-end"><%= money(@totals[:credit]) %></th>
          <th class="text-end"><%= money(@closing) %></th>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
