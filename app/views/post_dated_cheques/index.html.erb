<%= page_header "PDC Cheques", subtitle: "Post dated cheques and their clearing status", icon: "bi-cash-coin" do %>
  <%= permitted_link_to new_post_dated_cheque_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i>Add Cheque<% end %>
<% end %>

<div class="row g-3 mb-3">
  <% [
    ["Pending value", money(@totals[:pending]), "bi-hourglass-split", @totals[:pending_count]],
    ["Cleared value", money(@totals[:cleared]), "bi-check2-circle", nil],
    ["Bounced", @totals[:bounced].to_s, "bi-x-octagon", nil]
  ].each do |(label, value, icon, sub)| %>
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body d-flex align-items-center gap-3">
        <div class="rounded-circle bg-secondary-subtle text-secondary p-2"><i class="bi <%= icon %>"></i></div>
        <div>
          <div class="text-muted small"><%= label %><%= sub ? " (#{sub})" : "" %></div>
          <div class="fs-5 fw-semibold"><%= value %></div>
        </div>
      </div></div>
    </div>
  <% end %>
</div>

<div class="card">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="fw-semibold small text-secondary"><%= @cheques.size %> cheque(s)</span>
    <%= permitted_form_with url: post_dated_cheques_path, method: :get, local: true, class: "d-flex gap-2 flex-wrap qm-toolbar" do %>
      <%= text_field_tag :q, params[:q], class: "form-control form-control-sm", placeholder: "Search cheque, bank or customer" %>
      <%= select_tag :status, options_for_select([["All statuses", ""], %w[Pending pending], %w[Deposited deposited], %w[Cleared cleared], %w[Bounced bounced]], params[:status]),
                     class: "form-select form-select-sm" %>
      <%= submit_tag "Filter", class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>Cheque No</th><th>Bank</th><th>Customer Name</th><th>Account No</th><th class="text-end">Amount</th><th>Cheque Date</th><th>Covered Month</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        <% @cheques.each do |cheque| %>
          <tr>
            <td class="fw-semibold"><%= cheque.cheque_no %></td>
            <td><%= cheque.bank_name.presence || "—" %></td>
            <td><%= permitted_link_to cheque.customer.display_name, customer_path(cheque.customer) %></td>
            <td><%= tag.code(cheque.account_no.presence || cheque.customer&.account_no) %></td>
            <td class="text-end"><%= money(cheque.amount) %></td>
            <td><%= qm_date(cheque.cheque_date) %></td>
            <td><%= cheque.covered_month.presence || "—" %></td>
            <td><%= status_badge(cheque.status) %></td>
            <td class="text-end text-nowrap">
              <% if cheque.pending? %>
                <%= permitted_button_to "Deposit", deposit_post_dated_cheque_path(cheque), method: :patch, class: "btn btn-sm btn-outline-primary d-inline-block", form: { class: "d-inline" } %>
                <%= permitted_button_to "Clear", clear_post_dated_cheque_path(cheque), method: :patch, class: "btn btn-sm btn-outline-success d-inline-block", form: { class: "d-inline" } %>
                <%= permitted_button_to "Bounce", bounce_post_dated_cheque_path(cheque), method: :patch, class: "btn btn-sm btn-outline-danger d-inline-block", form: { class: "d-inline" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @cheques.empty? %>
          <tr><td colspan="9" class="text-center text-muted py-4">No cheques recorded.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
