<%= page_header "Add Post Dated Cheque", subtitle: "Track a cheque the customer promised for a future date", icon: "bi-cash-coin" do %>
  <%= permitted_link_to "Back", post_dated_cheques_path, class: "btn btn-light" %>
<% end %>

<%= permitted_form_with model: @cheque, url: post_dated_cheques_path, method: :post, local: true do |f| %>
  <% if @cheque.errors.any? %>
    <div class="alert alert-danger"><%= @cheque.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Cheque no *</label><%= f.text_field :cheque_no, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Bank</label><%= f.text_field :bank_name, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Account no</label><%= f.text_field :account_no, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Amount *</label><%= f.number_field :amount, step: "0.01", min: 0, class: "form-control" %></div>
        <div class="col-md-4">
          <label class="form-label">Customer *</label>
          <%= f.select :customer_id, @customers.map { |c| [c.display_name, c.id] }, { include_blank: "Select customer" }, class: "form-select" %>
        </div>
        <div class="col-md-4">
          <label class="form-label">Against sale</label>
          <%= f.select :sale_id, @sales.map { |s| ["#{s.sale_no} - #{s.customer.display_name}", s.id] }, { include_blank: "—" }, class: "form-select" %>
        </div>
        <div class="col-md-4">
          <label class="form-label">Cheque date *</label>
          <%= f.date_field :cheque_date, class: "form-control" %>
        </div>
        <div class="col-12"><label class="form-label">Remarks</label><%= f.text_area :remarks, rows: 2, class: "form-control" %></div>
      </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between">
      <%= permitted_link_to "Cancel", post_dated_cheques_path, class: "btn btn-light" %>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>Save cheque</button>
    </div>
  </div>
<% end %>
