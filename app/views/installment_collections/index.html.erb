<%= page_header "Installment Collection",
              subtitle: "Who pays today, and who has slipped behind",
              icon: "bi-wallet2" do %>
  <%= permitted_link_to "New sale", new_sale_path, class: "btn btn-primary" %><% end %>

<div class="row g-3 mb-3">
  <% [
    ["Due today", @summary[:due_today], "bi-calendar-day"],
    ["Amount due today", money(@summary[:amount_today]), "bi-cash-coin"],
    ["Overdue installments", @summary[:overdue], "bi-exclamation-triangle"],
    ["Overdue amount", money(@summary[:overdue_amount]), "bi-graph-down-arrow"]
  ].each_with_index do |(label, value, icon), index| %>
    <div class="col-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <div class="rounded-circle p-2 <%= index >= 2 ? 'bg-danger-subtle text-danger' : 'bg-primary-subtle text-primary' %>">
            <i class="bi <%= icon %>"></i>
          </div>
          <div>
            <div class="text-muted small"><%= label %></div>
            <div class="fs-5 fw-semibold"><%= value %></div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="card mb-3">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="fw-semibold">Today's list</span>
    <%= permitted_form_with url: installment_collections_path, method: :get, local: true, class: "d-flex gap-2 flex-wrap qm-toolbar" do %>
      <%= date_field_tag :day, @day, class: "form-control form-control-sm" %>
      <%= select_tag :filter, options_for_select([["All customers", ""], ["Defaulters", "overdue"]], params[:filter]),
                     class: "form-select form-select-sm" %>
      <%= text_field_tag :q, params[:q], class: "form-control form-control-sm", placeholder: "Search customer" %>
      <%= submit_tag "Apply", class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
  </div>

  <div class="table-responsive">
    <table class="table table-sm align-middle mb-0">
      <thead class="table-light">
        <tr><th class="text-end">#</th><th>Month</th><th>Customer</th><th class="text-end">Regular</th>
            <th class="text-end">Short C/F</th><th class="text-end">Total Due</th><th class="text-end">Paid</th>
            <th class="text-end">Short</th><th class="text-end">Late Fee</th><th>Status</th>
            <th class="text-end">Reminder</th><th class="text-end">Adjust</th></tr>
      </thead>
      <tbody>
        <% @today.each do |plan| %>
          <tr class="<%= 'table-warning' if plan.overdue? %>">
            <td class="text-end text-secondary"><%= plan.installment_no %></td>
            <td><%= qm_date(plan.due_date) %></td>
            <td>
              <%= permitted_link_to plan.sale.customer.display_name, customer_path(plan.sale.customer), class: "text-decoration-none" %>
              <div class="small text-muted"><%= plan.sale.customer.account_no %> · <%= permitted_link_to plan.sale.sale_no, sale_path(plan.sale) %></div>
            </td>
            <td class="text-end"><%= money(plan.amount - plan.short_amount.to_d) %></td>
            <td class="text-end"><%= money(plan.short_amount) %></td>
            <td class="text-end fw-semibold"><%= money(plan.remaining) %></td>
            <td class="text-end"><%= money(plan.paid_amount) %></td>
            <td class="text-end"><%= money([plan.short_amount.to_d - plan.paid_amount.to_d, 0].max) %></td>
            <td class="text-end"><%= money(plan.late_fee) %></td>
            <td><%= plan.overdue? ? status_badge("overdue") : status_badge("active") %></td>
            <td class="text-end text-nowrap">
              <%= permitted_button_to "Reminder", installment_reminder_path(plan), method: :post,
                            class: "btn btn-sm btn-outline-secondary d-inline-block",
                            form: { class: "d-inline" } %>
            </td>
            <td class="text-end qm-table-actions">
              <%= permitted_form_with url: installment_collections_path, method: :post, local: true,
                            class: "d-inline-flex gap-1", id: "collect_#{plan.id}" do %>
                <%= hidden_field_tag :sale_id, plan.sale_id %>
                <input type="number" step="0.01" min="0" name="amount" class="form-control form-control-sm qm-inline-field"
                       placeholder="<%= plan.remaining %>">
                <%= select_tag :payment_mode_id, options_for_select(@payment_modes.map { |m| [m.name, m.id] }),
                               class: "form-select form-select-sm qm-inline-field" %>
                <button class="btn btn-sm btn-primary" type="submit">Collect</button>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @today.empty? %>
          <tr><td colspan="12" class="text-center text-muted py-4">Nothing falls due on <%= qm_date(@day) %>.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header bg-white fw-semibold">Overdue installments</div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light"><tr><th>Customer</th><th>Sale</th><th>Due</th><th class="text-end">Outstanding</th><th class="text-end">Days late</th></tr></thead>
          <tbody>
            <% @overdue.sort_by { |p| -p.days_overdue }.first(25).each do |plan| %>
              <tr>
                <td><%= permitted_link_to plan.sale.customer.display_name, customer_path(plan.sale.customer) %></td>
                <td><%= permitted_link_to plan.sale.sale_no, sale_path(plan.sale) %></td>
                <td><%= qm_date(plan.due_date) %></td>
                <td class="text-end"><%= money(plan.remaining) %></td>
                <td class="text-end text-danger"><%= plan.days_overdue %></td>
              </tr>
            <% end %>
            <% if @overdue.empty? %>
              <tr><td colspan="5" class="text-center text-muted py-3">No overdue installments.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header bg-white fw-semibold">Customers due today</div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light"><tr><th>Account No</th><th>Customer Name</th><th>Phone</th><th>Due Month</th><th class="text-end">Total Due Amount</th></tr></thead>
          <tbody>
            <% @customers.each do |customer| %>
              <% sales = @collections.select { |s| s.customer_id == customer.id } %>
              <tr>
                <td><%= tag.code(customer.account_no) %></td>
                <td>
                  <%= permitted_link_to customer.display_name, customer_path(customer) %>
                  <% if customer.defaulter? %><span class="badge bg-danger ms-1">Defaulter</span><% end %>
                </td>
                <td class="small"><%= customer.phone.presence || "—" %></td>
                <td><%= qm_date(@day) %></td>
                <td class="text-end fw-semibold"><%= money(customer.overdue_amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>