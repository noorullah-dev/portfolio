<%= page_header "New Quotation", subtitle: "Prepare a price quote for a customer", icon: "bi-file-earmark-text" do %>
  <%= permitted_link_to "Back", quotations_path, class: "btn btn-light" %>
<% end %>

<%= permitted_form_with model: @quotation, url: quotations_path, method: :post, local: true do |f| %>
  <% if @quotation.errors.any? %>
    <div class="alert alert-danger"><%= @quotation.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Date *</label><%= f.date_field :quotation_date, class: "form-control" %></div>
        <div class="col-md-4">
          <label class="form-label">Customer</label>
          <%= f.select :customer_id, @customers.map { |c| [c.display_name, c.id] }, { include_blank: "Walk-in customer" }, class: "form-select", id: "quotation_customer" %>
        </div>
        <div class="col-md-3"><label class="form-label">Customer name</label><%= f.text_field :customer_name, class: "form-control" %></div>
        <div class="col-md-2"><label class="form-label">Phone</label><%= f.text_field :customer_phone, class: "form-control" %></div>
        <div class="col-md-4">
          <label class="form-label">Product</label>
          <%= f.select :product_id, @products.map { |p| [p.display_name, p.id] }, { include_blank: "—" }, class: "form-select" %>
        </div>
        <div class="col-md-4"><label class="form-label">Sale price</label><%= f.number_field :sale_price, step: "0.01", min: 0, class: "form-control" %></div>
        <div class="col-md-4"><label class="form-label">Down payment</label><%= f.number_field :down_payment, step: "0.01", min: 0, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Months</label><%= f.number_field :months, min: 0, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Valid until</label><%= f.date_field :valid_until, class: "form-control" %></div>
        <div class="col-md-3">
          <label class="form-label">Status</label>
          <%= f.select :status, Quotation::STATUSES, {}, class: "form-select" %>
        </div>
        <div class="col-12"><label class="form-label">Notes</label><%= f.text_area :notes, rows: 3, class: "form-control" %></div>
      </div>
      <div class="form-check mt-3">
        <%= check_box_tag :send_now, "1", false, class: "form-check-input", id: "send_now" %>
        <label class="form-check-label" for="send_now">Mark as sent immediately</label>
      </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between">
      <%= permitted_link_to "Cancel", quotations_path, class: "btn btn-light" %>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>Create quotation</button>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var select = document.getElementById("quotation_customer");
    if (!select) return;
    select.addEventListener("change", function () {
      var option = select.options[select.selectedIndex];
      var name = select.form.querySelector("[name='quotation[customer_name]']");
      if (name && option && option.value) name.value = option.textContent.split(" - ").slice(1).join(" - ");
    });
  });
</script>
