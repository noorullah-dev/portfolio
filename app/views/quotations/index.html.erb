<%= page_header "Quotations", subtitle: "Price quotes waiting on a decision", icon: "bi-file-earmark-text" do %>
  <%= permitted_link_to new_quotation_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i>New Quotation<% end %>
<% end %>

<div class="row g-3 mb-3">
  <% [["Open quotes", @summary[:open], "bi-hourglass-split"], ["Accepted / converted", @summary[:accepted], "bi-check2-circle"], ["Open value", money(@summary[:value]), "bi-cash-stack"]].each do |(label, value, icon)| %>
    <div class="col-md-4"><div class="card"><div class="card-body d-flex align-items-center gap-3">
      <div class="rounded-circle bg-secondary-subtle text-secondary p-2"><i class="bi <%= icon %>"></i></div>
      <div><div class="text-muted small"><%= label %></div><div class="fs-5 fw-semibold"><%= value %></div></div>
    </div></div></div>
  <% end %>
</div>

<div class="card">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="fw-semibold small text-secondary"><%= @quotations.total_count %> quotation(s)</span>
    <%= permitted_form_with url: quotations_path, method: :get, local: true, class: "d-flex gap-2 flex-wrap qm-toolbar" do %>
      <%= text_field_tag :q, params[:q], class: "form-control form-control-sm", placeholder: "Search no or customer" %>
      <%= select_tag :status, options_for_select([["All", ""]] + Quotation::STATUSES.map { |s| [s.titleize, s] }, params[:status]), class: "form-select form-select-sm" %>
      <%= submit_tag "Filter", class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th class="text-end">#</th><th>QT No</th><th>Date</th><th>Valid Until</th><th>Customer</th><th>Product</th><th class="text-end">Sale Price</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        <% @quotations.each do |quotation| %>
          <tr>
            <td class="text-end text-secondary"><%= quotation.id %></td>
            <td class="fw-semibold"><%= quotation.quotation_no %></td>
            <td><%= qm_date(quotation.quotation_date) %></td>
            <td><%= qm_date(quotation.valid_until) %></td>
            <td><%= quotation.customer ? permitted_link_to(quotation.customer.display_name, customer_path(quotation.customer)) : quotation.customer_name %></td>
            <td class="small text-secondary"><%= quotation.vehicle_label.presence || "—" %></td>
            <td class="text-end"><%= money(quotation.sale_price) %></td>
            <td><%= status_badge(quotation.status) %></td>
            <td class="text-end text-nowrap">
              <% if quotation.open_quote? %>
                <%= permitted_button_to "Convert", accept_quotation_path(quotation), method: :post,
                              class: "btn btn-sm btn-primary d-inline-block", form: { class: "d-inline" } %>
              <% elsif quotation.converted_sale %>
                <%= permitted_link_to "Sale #{quotation.converted_sale.sale_no}", sale_path(quotation.converted_sale), class: "btn btn-sm btn-outline-secondary" %>
              <% end %>
              <%= permitted_button_to quotation_path(quotation), method: :delete, title: "Delete",
                            class: "btn btn-sm btn-outline-danger d-inline-block",
                            form: { class: "d-inline", data: { confirm: "Delete this quotation?" } } do %><i class="bi bi-trash me-1"></i>Delete<% end %>
            </td>
          </tr>
        <% end %>
        <% if @quotations.empty? %>
          <tr><td colspan="9" class="text-center text-muted py-4">No quotations yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @quotations.total_pages > 1 %>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center">
      <span class="small text-secondary">Page <%= @quotations.current_page %> of <%= @quotations.total_pages %></span>
      <span class="d-flex gap-2">
        <%= permitted_link_to "Previous", url_for(page: [@quotations.current_page - 1, 1].max), class: "btn btn-sm btn-outline-secondary" %>
        <%= permitted_link_to "Next", url_for(page: [@quotations.current_page + 1, @quotations.total_pages].min), class: "btn btn-sm btn-outline-secondary" %>
      </span>
    </div>
  <% end %>
</div>
