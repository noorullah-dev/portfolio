<%= page_header "Purchases List", subtitle: "Stock bought, supplier balances and payments", icon: "bi-cart-plus" do %>
  <%= permitted_link_to new_purchase_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i>New Purchase<% end %>
<% end %>

<div class="card">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="fw-semibold small text-secondary"><%= @total_count %> purchase(s)</span>
    <%= permitted_form_with url: purchases_path, method: :get, local: true, class: "d-flex gap-2 flex-wrap qm-toolbar" do %>
      <%= text_field_tag :q, params[:q], class: "form-control form-control-sm qm-search",
                          placeholder: "Search purchase #, invoice or supplier" %>
      <%= submit_tag "Search", class: "btn btn-sm btn-outline-secondary" %>
      <%= permitted_link_to "Reset", purchases_path, class: "btn btn-sm btn-light" %>
    <% end %>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th>Purchase No</th><th>Date</th><th>Supplier</th><th>Invoice No</th><th class="text-end">Items</th>
            <th class="text-end">Total</th><th class="text-end">Paid</th><th class="text-end">Balance</th><th>Status</th><th class="text-end">Actions</th></tr>
      </thead>
      <tbody>
        <% records = @purchases.respond_to?(:records) ? @purchases.records : @purchases %>
        <% records.each do |purchase| %>
          <tr>
            <td><%= permitted_link_to purchase.purchase_no, purchase_path(purchase), class: "fw-semibold text-decoration-none" %></td>
            <td><%= qm_date(purchase.purchase_date) %></td>
            <td><%= permitted_link_to purchase.supplier.name, supplier_path(purchase.supplier), class: "text-decoration-none" %></td>
            <td><%= purchase.invoice_no.presence || "—" %></td>
            <td class="text-end"><%= purchase.items.size %></td>
            <td class="text-end"><%= money(purchase.total_amount) %></td>
            <td class="text-end"><%= money(purchase.paid_amount) %></td>
            <td class="text-end">
              <% if purchase.paid? %>
                <span class="badge bg-success">Settled</span>
              <% else %>
                <%= money(purchase.balance) %>
              <% end %>
            </td>
            <td><%= status_badge(purchase.status) %></td>
            <td class="text-end text-nowrap">
              <%= permitted_link_to purchase_path(purchase), class: "btn btn-sm btn-outline-secondary", title: "View" do %><i class="bi bi-eye"></i><% end %>
              <%= permitted_link_to edit_purchase_path(purchase), class: "btn btn-sm btn-outline-primary", title: "Edit" do %><i class="bi bi-pencil"></i><% end %>
            </td>
          </tr>
        <% end %>
        <% if records.empty? %>
          <tr><td colspan="10" class="text-center text-muted py-4"><i class="bi bi-inbox me-2"></i>No purchases found.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @purchases.respond_to?(:total_pages) && @purchases.total_pages > 1 %>
    <div class="px-4 py-3 border-top d-flex justify-content-between align-items-center">
      <span class="small text-muted">Page <%= @purchases.current_page %> of <%= @purchases.total_pages %></span>
      <span>
        <%= permitted_link_to "Previous", url_for(page: (@purchases.current_page - 1)), class: "btn btn-sm btn-outline-secondary #{'disabled' if @purchases.current_page == 1}" %>
        <%= permitted_link_to "Next", url_for(page: (@purchases.current_page + 1)), class: "btn btn-sm btn-outline-secondary #{'disabled' if @purchases.current_page == @purchases.total_pages}" %>
      </span>
    </div>
  <% end %>
</div>