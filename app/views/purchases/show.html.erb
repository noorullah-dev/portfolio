<%= page_header "Purchase #{@purchase.purchase_no}",
              subtitle: "#{qm_date(@purchase.purchase_date)} · #{@purchase.supplier.name}",
              icon: "bi-cart-plus" do %>
  <div class="d-flex gap-2">
    <%= permitted_link_to edit_purchase_path(@purchase), class: "btn btn-outline-primary" do %><i class="bi bi-pencil me-1"></i>Edit<% end %>
    <%= permitted_link_to "Back", purchases_path, class: "btn btn-light" %>
  </div>
<% end %>

<div class="row g-3 mb-3">
  <% [
    ["Total", money(@purchase.total_amount)],
    ["Paid", money(@purchase.paid_amount)],
    ["Balance", money(@purchase.balance)],
    ["Stock units created", @purchase.stock_units.size],
    ["Status", @purchase.status.humanize]
  ].each do |(label, value)| %>
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card h-100"><div class="card-body py-3">
        <div class="text-muted small"><%= label %></div>
        <div class="fw-semibold"><%= value %></div>
      </div></div>
    </div>
  <% end %>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card mb-3">
      <div class="card-header bg-white fw-semibold">Items</div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light"><tr><th>Item</th><th>Engine no</th><th>Chassis no</th><th class="text-end">Qty</th><th class="text-end">Price</th><th class="text-end">Total</th><th>Stock</th></tr></thead>
          <tbody>
            <% @items.each do |item| %>
              <tr>
                <td>
                  <%= item.product&.name || item.description || "—" %>
                  <div class="small text-muted"><%= item.variant&.value %></div>
                </td>
                <td><%= item.engine_no.presence || "—" %></td>
                <td><%= item.chassis_no.presence || "—" %></td>
                <td class="text-end"><%= item.qty %></td>
                <td class="text-end"><%= money(item.unit_price) %></td>
                <td class="text-end"><%= money(item.total) %></td>
                <td>
                  <% if item.create_stock_unit %>
                    <%= permitted_link_to @purchase.stock_units.where(purchase_item_id: item.id).count, stock_units_path(status: "available"), class: "badge bg-primary" %>
                  <% else %>
                    <span class="badge bg-secondary">No</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if @items.empty? %>
              <tr><td colspan="7" class="text-center text-muted py-3">No items on this purchase.</td></tr>
            <% end %>
          </tbody>
          <tfoot class="table-light">
            <tr><th colspan="5" class="text-end">Total</th><th class="text-end"><%= money(@purchase.total_amount) %></th><th></th></tr>
          </tfoot>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-white fw-semibold">Payments to supplier</div>
      <div class="card-body">
        <% if @purchase.paid? %>
          <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>This purchase is fully paid.</div>
        <% end %>

        <%= permitted_form_with url: purchase_purchase_payments_path(@purchase), method: :post, local: true, class: "row g-2 align-items-end" do %>
          <div class="col-md-3">
            <label class="form-label small">Amount</label>
            <input type="number" step="0.01" min="0" name="amount" class="form-control" value="<%= @purchase.balance > 0 ? @purchase.balance : '' %>" required>
          </div>
          <div class="col-md-3">
            <label class="form-label small">Date</label>
            <input type="date" name="payment_date" class="form-control" value="<%= Date.current %>">
          </div>
          <div class="col-md-3">
            <label class="form-label small">Mode</label>
            <%= select_tag :payment_mode_id,
                           options_for_select(PaymentMode.cash_first.map { |m| [m.name, m.id] }),
                           class: "form-select", include_blank: "—" %>
          </div>
          <div class="col-md-2">
            <label class="form-label small">Reference</label>
            <input type="text" name="reference" class="form-control">
          </div>
          <div class="col-md-1">
            <button class="btn btn-primary w-100" type="submit">Pay</button>
          </div>
        <% end %>

        <% if @payments.any? %>
          <div class="table-responsive mt-3">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th>Date</th><th>Mode</th><th>Reference</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
              <% @payments.each do |payment| %>
                <tr>
                  <td><%= qm_date(payment.payment_date) %></td>
                  <td><%= payment.payment_mode&.name || "—" %></td>
                  <td><%= payment.reference.presence || "—" %></td>
                  <td class="text-end"><%= money(payment.amount) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card mb-3">
      <div class="card-header bg-white fw-semibold">Supplier</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5 text-secondary small">Name</dt><dd class="col-7"><%= permitted_link_to @purchase.supplier.name, supplier_path(@purchase.supplier) %></dd>
          <dt class="col-5 text-secondary small">Phone</dt><dd class="col-7"><%= @purchase.supplier.phone.presence || "—" %></dd>
          <dt class="col-5 text-secondary small">City</dt><dd class="col-7"><%= @purchase.supplier.city.presence || "—" %></dd>
          <dt class="col-5 text-secondary small">Total purchases</dt><dd class="col-7"><%= money(@purchase.supplier.total_purchases) %></dd>
          <dt class="col-5 text-secondary small">Total paid</dt><dd class="col-7"><%= money(@purchase.supplier.total_paid) %></dd>
          <dt class="col-5 text-secondary small">Balance</dt><dd class="col-7 fw-semibold"><%= money(@purchase.supplier.balance) %></dd>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-white fw-semibold">Details</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5 text-secondary small">Invoice no</dt><dd class="col-7"><%= @purchase.invoice_no.presence || "—" %></dd>
          <dt class="col-5 text-secondary small">Payment type</dt><dd class="col-7"><%= @purchase.payment_type.humanize %></dd>
          <dt class="col-5 text-secondary small">Recorded by</dt><dd class="col-7"><%= @purchase.created_by&.full_name || "—" %></dd>
          <dt class="col-5 text-secondary small">Notes</dt><dd class="col-7"><%= @purchase.notes.presence || "—" %></dd>
        </dl>
      </div>
    </div>
  </div>
</div>