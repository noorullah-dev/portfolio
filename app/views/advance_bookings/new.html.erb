<%= page_header "New Advance Booking", subtitle: "Reserve a vehicle and record the advance received", icon: "bi-journal-check" do %>
  <%= permitted_link_to "Back", advance_bookings_path, class: "btn btn-light" %>
<% end %>

<%= permitted_form_with model: @booking, url: advance_bookings_path, method: :post, local: true do |f| %>
  <% if @booking.errors.any? %>
    <div class="alert alert-danger"><%= @booking.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="card mb-3">
    <div class="card-header bg-white fw-semibold">Booking details</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Date *</label><%= f.date_field :booking_date, class: "form-control" %></div>
        <div class="col-md-4">
          <label class="form-label">Customer</label>
          <%= f.select :customer_id, @customers.map { |c| [c.display_name, c.id] }, { include_blank: "Walk-in customer" }, class: "form-select", id: "booking_customer" %>
        </div>
        <div class="col-md-3"><label class="form-label">Customer name</label><%= f.text_field :customer_name, class: "form-control" %></div>
        <div class="col-md-2"><label class="form-label">Phone</label><%= f.text_field :customer_phone, class: "form-control" %></div>
        <div class="col-md-4">
          <label class="form-label">Product</label>
          <%= f.select :product_id, @products.map { |p| [p.display_name, p.id] }, { include_blank: "Any" }, class: "form-select" %>
        </div>
        <div class="col-md-4">
          <label class="form-label">Stock unit</label>
          <%= f.select :stock_unit_id, @stock_units.map { |u| [u.display_name, u.id] }, { include_blank: "Any" }, class: "form-select" %>
        </div>
        <div class="col-md-4">
          <label class="form-label">Agent</label>
          <%= f.select :agent_id, @agents.map { |a| [a.name, a.id] }, { include_blank: "—" }, class: "form-select" %>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-white fw-semibold">Financials</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Sale type</label><%= f.select :sale_type, %w[credit cash], {}, class: "form-select" %></div>
        <div class="col-md-3"><label class="form-label">Total amount</label><%= f.number_field :total_amount, step: "0.01", min: 0, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Advance received</label><%= f.number_field :advance_amount, step: "0.01", min: 0, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Months</label><%= f.number_field :months, min: 0, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Expected delivery</label><%= f.date_field :expected_delivery, class: "form-control" %></div>
        <div class="col-md-3">
          <label class="form-label">Late fee rule</label>
          <%= f.select :late_fee_type, %w[none percent fixed], {}, class: "form-select" %>
        </div>
        <div class="col-md-3">
          <label class="form-label">Status</label>
          <%= f.select :status, AdvanceBooking::STATUSES, {}, class: "form-select" %>
        </div>
        <div class="col-12"><label class="form-label">Remarks</label><%= f.text_area :remarks, rows: 2, class: "form-control" %></div>
      </div>
      <p class="text-muted small mb-0 mt-3"><i class="bi bi-info-circle me-1"></i>Any advance amount entered here is posted to the cash book on save.</p>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between">
      <%= permitted_link_to "Cancel", advance_bookings_path, class: "btn btn-light" %>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>Create booking</button>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var select = document.getElementById("booking_customer");
    if (!select) return;
    select.addEventListener("change", function () {
      var option = select.options[select.selectedIndex];
      if (!option || !option.value) return;
      var form = select.form;
      var name = form.querySelector("[name='advance_booking[customer_name]']");
      var phone = form.querySelector("[name='advance_booking[customer_phone]']");
      if (name) name.value = option.textContent.split(" - ").slice(1).join(" - ");
      if (phone && phone.value === "") phone.value = "";
    });
  });
</script>
