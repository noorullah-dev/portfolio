<%= page_header "Edit Booking #{@booking.booking_no}", subtitle: "Update booking details", icon: "bi-pencil" do %>
  <%= permitted_link_to "Back", advance_booking_path(@booking), class: "btn btn-light" %>
<% end %>

<%= permitted_form_with model: @booking, url: advance_booking_path(@booking), method: :patch, local: true do |f| %>
  <% if @booking.errors.any? %>
    <div class="alert alert-danger"><%= @booking.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="card"><div class="card-body">
    <div class="row g-3">
      <div class="col-md-3"><label class="form-label">Date</label><%= f.date_field :booking_date, class: "form-control" %></div>
      <div class="col-md-4">
        <label class="form-label">Customer</label>
        <%= f.select :customer_id, @customers.map { |c| [c.display_name, c.id] }, { include_blank: "Walk-in customer" }, class: "form-select" %>
      </div>
      <div class="col-md-3"><label class="form-label">Customer name</label><%= f.text_field :customer_name, class: "form-control" %></div>
      <div class="col-md-2"><label class="form-label">Phone</label><%= f.text_field :customer_phone, class: "form-control" %></div>
      <div class="col-md-3"><label class="form-label">Total amount</label><%= f.number_field :total_amount, step: "0.01", min: 0, class: "form-control" %></div>
      <div class="col-md-3"><label class="form-label">Months</label><%= f.number_field :months, min: 0, class: "form-control" %></div>
      <div class="col-md-3"><label class="form-label">Expected delivery</label><%= f.date_field :expected_delivery, class: "form-control" %></div>
      <div class="col-md-3">
        <label class="form-label">Status</label>
        <%= f.select :status, AdvanceBooking::STATUSES, {}, class: "form-select" %>
      </div>
      <div class="col-12"><label class="form-label">Remarks</label><%= f.text_area :remarks, rows: 2, class: "form-control" %></div>
    </div>
  </div>
  <div class="card-footer bg-white d-flex justify-content-between">
    <%= permitted_link_to "Cancel", advance_booking_path(@booking), class: "btn btn-light" %>
    <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>Save changes</button>
  </div></div>
<% end %>
