<%= page_header @booking.booking_no.to_s, subtitle: @booking.customer&.display_name || @booking.customer_name, icon: "bi-journal-check" do %>
  <%= permitted_link_to "Back", advance_bookings_path, class: "btn btn-light" %>
<% end %>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card mb-3">
      <div class="card-header bg-white fw-semibold">Booking</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-3 text-secondary small">Date</dt><dd class="col-sm-9"><%= qm_date(@booking.booking_date) %></dd>
          <dt class="col-sm-3 text-secondary small">Customer</dt>
          <dd class="col-sm-9">
            <% if @booking.customer %><%= permitted_link_to @booking.customer.display_name, customer_path(@booking.customer) %><% else %><%= @booking.customer_name.presence || "—" %><% end %>
            <span class="text-muted small"><%= @booking.customer_phone %></span>
          </dd>
          <dt class="col-sm-3 text-secondary small">Vehicle</dt><dd class="col-sm-9"><%= @booking.vehicle_label.presence || "—" %></dd>
          <dt class="col-sm-3 text-secondary small">Sale type</dt><dd class="col-sm-9 text-capitalize"><%= @booking.sale_type %></dd>
          <dt class="col-sm-3 text-secondary small">Expected delivery</dt><dd class="col-sm-9"><%= qm_date(@booking.expected_delivery) %></dd>
          <dt class="col-sm-3 text-secondary small">Status</dt><dd class="col-sm-9"><%= status_badge(@booking.status) %></dd>
          <dt class="col-sm-3 text-secondary small">Months</dt><dd class="col-sm-9"><%= @booking.months %></dd>
          <% if @booking.remarks.present? %>
            <dt class="col-sm-3 text-secondary small">Remarks</dt><dd class="col-sm-9"><%= @booking.remarks %></dd>
          <% end %>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-white fw-semibold">Installment plan</div>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light"><tr><th>#</th><th>Due date</th><th class="text-end">Amount</th><th class="text-end">Paid</th><th class="text-end">Remaining</th><th>Status</th></tr></thead>
          <tbody>
            <% @plans.each do |plan| %>
              <tr>
                <td><%= plan.installment_no %></td>
                <td><%= qm_date(plan.due_date) %></td>
                <td class="text-end"><%= money(plan.amount) %></td>
                <td class="text-end"><%= money(plan.paid_amount) %></td>
                <td class="text-end"><%= money(plan.remaining) %></td>
                <td><%= status_badge(plan.status) %></td>
              </tr>
            <% end %>
            <% if @plans.empty? %>
              <tr><td colspan="6" class="text-center text-muted py-3">Cash booking — no installment plan.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card mb-3"><div class="card-body">
      <div class="d-flex justify-content-between"><span class="text-secondary small">Total</span><strong><%= money(@booking.total_amount) %></strong></div>
      <div class="d-flex justify-content-between"><span class="text-secondary small">Advance</span><strong><%= money(@booking.advance_amount) %></strong></div>
      <div class="d-flex justify-content-between"><span class="text-secondary small">Received</span><strong><%= money(@booking.paid_amount) %></strong></div>
      <div class="d-flex justify-content-between border-top mt-2 pt-2"><span class="text-secondary small">Balance</span><strong class="text-danger"><%= money(@booking.balance) %></strong></div>
      <% if @booking.monthly_amount.to_d.positive? %>
        <div class="d-flex justify-content-between"><span class="text-secondary small">Monthly</span><strong><%= money(@booking.monthly_amount) %></strong></div>
      <% end %>
    </div></div>

    <div class="card">
      <div class="card-header bg-white fw-semibold">Record payment</div>
      <div class="card-body">
        <%= permitted_form_with url: advance_booking_advance_booking_payments_path(@booking), method: :post, local: true do %>
          <div class="mb-2"><label class="form-label small">Amount *</label><input type="number" step="0.01" min="0" name="amount" class="form-control" required></div>
          <div class="mb-2"><label class="form-label small">Date</label><input type="date" name="payment_date" value="<%= Date.current %>" class="form-control"></div>
          <div class="mb-3">
            <label class="form-label small">Payment mode</label>
            <select name="payment_mode_id" class="form-select">
              <option value="">—</option>
              <% PaymentMode.cash_first.each do |mode| %><option value="<%= mode.id %>"><%= mode.name %></option><% end %>
            </select>
          </div>
          <div class="mb-3"><label class="form-label small">Remarks</label><input type="text" name="remarks" class="form-control"></div>
          <button class="btn btn-primary w-100" type="submit"><i class="bi bi-check-lg me-1"></i>Add payment</button>
        <% end %>
      </div>
    </div>
  </div>
</div>
