<%= page_header "Advance Bookings", subtitle: "Bookings taken with an advance payment", icon: "bi-journal-check" do %>
  <%= permitted_link_to new_advance_booking_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i>New Booking<% end %>
<% end %>

<div class="row g-3 mb-3">
  <% [["Confirmed", @summary[:confirmed], "bi-journal-check"], ["Advance received", money(@summary[:advance]), "bi-cash-stack"], ["Receivable", money(@summary[:receivable]), "bi-hourglass-split"]].each do |(label, value, icon)| %>
    <div class="col-md-4"><div class="card"><div class="card-body d-flex align-items-center gap-3">
      <div class="rounded-circle bg-secondary-subtle text-secondary p-2"><i class="bi <%= icon %>"></i></div>
      <div><div class="text-muted small"><%= label %></div><div class="fs-5 fw-semibold"><%= value %></div></div>
    </div></div></div>
  <% end %>
</div>

<div class="card">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="fw-semibold small text-secondary"><%= @bookings.total_count %> booking(s)</span>
    <%= permitted_form_with url: advance_bookings_path, method: :get, local: true, class: "d-flex gap-2 flex-wrap qm-toolbar" do %>
      <%= text_field_tag :q, params[:q], class: "form-control form-control-sm", placeholder: "Search no, name or phone" %>
      <%= select_tag :status, options_for_select([["All", ""], %w[Confirmed confirmed], %w[Delivered delivered], %w[Cancelled cancelled]], params[:status]), class: "form-select form-select-sm" %>
      <%= submit_tag "Filter", class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>Booking No</th><th>Date</th><th>Customer</th><th>Product</th><th class="text-end">Total</th><th class="text-end">Advance Paid</th><th class="text-end">Balance</th><th>Expected Delivery</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        <% @bookings.each do |booking| %>
          <tr>
            <td class="fw-semibold"><%= booking.booking_no %></td>
            <td><%= qm_date(booking.booking_date) %></td>
            <td><%= booking.customer ? permitted_link_to(booking.customer.display_name, customer_path(booking.customer)) : booking.customer_name %></td>
            <td class="small text-secondary"><%= booking.vehicle_label.presence || "—" %></td>
            <td class="text-end"><%= money(booking.total_amount) %></td>
            <td class="text-end"><%= money(booking.advance_amount) %></td>
            <td class="text-end"><%= money(booking.balance) %></td>
            <td><%= booking.expected_delivery ? qm_date(booking.expected_delivery) : "—" %></td>
            <td><%= status_badge(booking.status) %></td>
            <td class="text-end text-nowrap">
              <%= permitted_link_to advance_booking_path(booking), class: "btn btn-sm btn-outline-secondary" do %><i class="bi bi-eye"></i><% end %>
              <%= permitted_link_to edit_advance_booking_path(booking), class: "btn btn-sm btn-outline-secondary" do %><i class="bi bi-pencil"></i><% end %>
            </td>
          </tr>
        <% end %>
        <% if @bookings.empty? %>
          <tr><td colspan="10" class="text-center text-muted py-4">No bookings yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @bookings.total_pages > 1 %>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center">
      <span class="small text-secondary">Page <%= @bookings.current_page %> of <%= @bookings.total_pages %> · <%= @bookings.total_count %> records</span>
      <span class="d-flex gap-2">
        <%= permitted_link_to "Previous", url_for(page: [@bookings.current_page - 1, 1].max), class: "btn btn-sm btn-outline-secondary #{'disabled' if @bookings.current_page <= 1}" %>
        <%= permitted_link_to "Next", url_for(page: [@bookings.current_page + 1, @bookings.total_pages].min), class: "btn btn-sm btn-outline-secondary #{'disabled' if @bookings.current_page >= @bookings.total_pages}" %>
      </span>
    </div>
  <% end %>
</div>
