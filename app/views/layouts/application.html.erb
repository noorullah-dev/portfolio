<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= document_title %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <meta name="theme-color" content="#6366f1">
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="stylesheet" href="/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="/vendor/bootstrap-icons.min.css">
    <%= stylesheet_link_tag "site", "data-turbo-track": "reload" %>
    <script>
      /* Applies the saved appearance before first paint, so there is no flash
         of the light theme on page load. */
      (function () {
        try {
          var root = document.documentElement;
          var media = window.matchMedia("(prefers-color-scheme: dark)");
          var theme = localStorage.getItem("qm.theme") || "light";
          if (theme === "auto") theme = media.matches ? "dark" : "light";
          var accent = localStorage.getItem("qm.accent") || "indigo";
          var density = localStorage.getItem("qm.density") || "comfortable";
          root.setAttribute("data-theme", theme);
          root.setAttribute("data-bs-theme", theme);
          root.setAttribute("data-accent", accent);
          root.setAttribute("data-density", density);
          media.addEventListener("change", function () {
            if ((localStorage.getItem("qm.theme") || "light") === "auto") {
              var t = media.matches ? "dark" : "light";
              root.setAttribute("data-theme", t);
              root.setAttribute("data-bs-theme", t);
            }
          });
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="qm-wrapper">

      <aside id="sidebar" class="qm-sidebar">
        <div class="sidebar-brand">
          <div class="brand-icon-wrap">
            <i class="bi bi-cash-coin"></i>
          </div>
          <div class="brand-text">
            <span class="brand-name" id="spBizName"><%= current_user&.tenant_label || business&.name || "QistManager" %></span>
            <span class="brand-tagline">Management System</span>
          </div>
        </div>

        <nav class="sidebar-nav-wrap">
          <ul class="sidebar-nav" id="sidebarNav">
            <% nav_sections.each do |section| %>
              <% if section[:label] %>
                <li class="nav-section-label <%= (section[:keys] || []).map { |k| "qm-menu-#{k}" }.join(" ") %>">
                  <%= section[:label] %>
                </li>
              <% end %>

              <% Array(section[:items]).each do |item| %>
                <li class="nav-item <%= "qm-menu-#{item[:key]}" if item[:key] %>">
                  <% if item[:children] %>
                    <a href="#menu<%= item[:key].to_s.camelize %>" data-bs-toggle="collapse"
                       class="<%= nav_link_class(item).join(" ") %>"
                       aria-expanded="<%= nav_group_open?(item) %>">
                      <span class="nav-icon"><i class="bi <%= item[:icon] %>"></i></span>
                      <span class="nav-text"><%= item[:text] %></span>
                      <i class="bi bi-chevron-right nav-arrow"></i>
                    </a>
                    <div id="menu<%= item[:key].to_s.camelize %>" class="<%= collapse_class(item) %>">
                      <ul class="nav-submenu">
                        <% item[:children].each do |child| %>
                          <li>
                            <a href="<%= public_send(child[:path]) %>" class="<%= "active" if nav_active?(child) %>">
                              <i class="bi <%= child[:icon] %>"></i><%= child[:text] %>
                            </a>
                          </li>
                        <% end %>
                      </ul>
                    </div>
                  <% else %>
                    <a href="<%= public_send(item[:path]) %>" class="<%= nav_link_class(item).join(" ") %> <%= "active" if nav_active?(item) %>">
                      <span class="nav-icon"><i class="bi <%= item[:icon] %>"></i></span>
                      <span class="nav-text"><%= item[:text] %></span>
                    </a>
                  <% end %>
                </li>
              <% end %>
            <% end %>
          </ul>
        </nav>

        <div class="sidebar-footer">
          <div class="sf-avatar"><i class="bi bi-person-circle"></i></div>
          <div class="sf-info">
            <div class="sf-name" id="spSfName"><%= current_user.full_name %></div>
            <div class="sf-role" id="spSfRole"><%= current_user.display_role %></div>
          </div>
          <%= permitted_link_to logout_path, class: "sf-logout", title: "Logout", data: { turbo: false } do %>
            <i class="bi bi-box-arrow-right"></i>
          <% end %>
        </div>
      </aside>

      <div id="mainContent" class="qm-main">
        <header class="qm-topbar">
          <div class="topbar-left">
            <button class="topbar-toggle" id="sidebarToggleBtn" type="button" aria-label="Toggle sidebar">
              <i class="bi bi-list"></i>
            </button>
            <div class="topbar-breadcrumb">
              <span class="tb-biz" id="spBizNameTop"><%= current_user&.tenant_label || business&.name || "QistManager" %></span>
            </div>
          </div>

          <div class="topbar-right">
            <%= render "shared/shop_switcher" %>

            <button class="topbar-icon-btn tb-notif" type="button">
              <i class="bi bi-bell"></i>
              <span class="notif-dot"></span>
            </button>

            <%= render "shared/theme_switcher" %>

            <div class="dropdown">
              <button class="user-pill dropdown-toggle" type="button" id="userDropdown"
                      data-bs-toggle="dropdown" aria-expanded="false">
                <span class="user-avatar-sm"><i class="bi bi-person-fill"></i></span>
                <span class="user-pill-name d-none d-sm-inline" id="spNavUser"><%= current_user.full_name %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="userDropdown">
                <li>
                  <div class="udm-header">
                    <div class="udm-avatar"><i class="bi bi-person-circle"></i></div>
                    <div>
                      <div class="udm-name" id="spNavFullName"><%= current_user.full_name %></div>
                      <span class="udm-badge" id="spNavRole"><%= current_user.display_role %></span>
                    </div>
                  </div>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li><%= permitted_link_to business_settings_path, class: "dropdown-item" do %><i class="bi bi-gear me-2"></i>Settings<% end %></li>
                <li><%= permitted_link_to change_password_path, class: "dropdown-item" do %><i class="bi bi-key me-2"></i>Change Password<% end %></li>
                <li><%= permitted_link_to logout_path, class: "dropdown-item text-danger" do %><i class="bi bi-box-arrow-right me-2"></i>Logout<% end %></li>
              </ul>
            </div>
          </div>
        </header>

        <main class="qm-page-content">
          <% flash.each do |level, message| %>
            <div class="alert <%= flash_class(level) %> alert-dismissible fade show" role="alert">
              <%= message %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>

          <div id="divMain" style="">
            <%= yield %>
          </div>
        </main>
      </div>
    </div>

    <%= render "shared/tab_bar" unless native_app? %>

    <script>
      // Mirrors the captured Site.master bootstrap object so the shared
      // helpers (print headers, toasts, formatting) behave as designed.
      var QM = {
        bizName: <%= raw((current_user&.tenant_label || business&.name || "QistManager").to_json) %>,
        bizAddress: <%= raw business&.address.to_json %>,
        bizPhone: <%= raw business&.phone.to_json %>,
        bizEmail: <%= raw business&.email.to_json %>,
        bizLogo: <%= raw business&.logo_path.to_json %>,
        bizFooter: <%= raw business&.footer_text.to_json %>,
        bizType: <%= raw business&.business_type.to_json %>,
        currency: <%= raw((business&.currency_symbol || business&.currency || "Rs.").to_json) %>,
        fullName: <%= raw current_user.full_name.to_json %>,
        username: <%= raw current_user.username.to_json %>,
        role: <%= raw current_user.display_role.to_json %>
      };
    </script>
    <% if business&.footer_text.present? %>
      <div class="print-footer print-only"><%= business.footer_text %></div>
    <% end %>
    <script src="/vendor/jquery.min.js"></script>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
    <script src="/vendor/chart.umd.min.js"></script>
    <%= javascript_include_tag "site", "data-turbo-track": "reload", defer: false %>
  </body>
</html>