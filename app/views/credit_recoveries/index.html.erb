<%= page_header "Credit Recoveries", subtitle: "Field recovery visits and amounts collected", icon: "bi-shield-check" do %>
  <%= permitted_link_to new_credit_recovery_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i>Record Recovery<% end %>
<% end %>

<div class="row g-3 mb-3">
  <% [["This month", money(@totals[:month]), "bi-calendar-month"], ["All time", money(@totals[:all_time]), "bi-cash-stack"], ["Entries", @totals[:count].to_s, "bi-journal-text"]].each do |(label, value, icon)| %>
    <div class="col-md-4"><div class="card"><div class="card-body d-flex align-items-center gap-3">
      <div class="rounded-circle bg-secondary-subtle text-secondary p-2"><i class="bi <%= icon %>"></i></div>
      <div><div class="text-muted small"><%= label %></div><div class="fs-5 fw-semibold"><%= value %></div></div>
    </div></div></div>
  <% end %>
</div>

<% if @defaulters.any? %>
  <div class="card mb-3">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-exclamation-triangle me-1 text-warning"></i>Defaulters needing a visit</div>
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Customer</th><th>Contact</th><th class="text-end">Balance</th><th class="text-end">Overdue</th><th class="text-end"></th></tr></thead>
        <tbody>
          <% @defaulters.each do |customer| %>
            <tr>
              <td><%= permitted_link_to customer.display_name, customer_path(customer) %></td>
              <td class="small text-secondary"><%= customer.phone.presence || "—" %></td>
              <td class="text-end"><%= money(customer.balance) %></td>
              <td class="text-end text-danger"><%= money(customer.overdue_amount) %></td>
              <td class="text-end"><%= permitted_link_to "Add", new_credit_recovery_path(customer_id: customer.id), class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<div class="card mb-3">
  <div class="card-header bg-white fw-semibold"><i class="bi bi-clipboard2-pulse me-1"></i>Financed sales needing recovery</div>
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th>Sale No</th><th>Customer</th><th>Account No</th><th>Product</th><th>Agreed Date</th>
            <th class="text-end">Total</th><th class="text-end">Paid</th><th class="text-end">Balance</th>
            <th>Status</th><th class="text-end">Actions</th></tr>
      </thead>
      <tbody>
        <% @plans.each do |sale| %>
          <tr>
            <td><%= permitted_link_to sale.sale_no, sale_path(sale), class: "fw-semibold text-decoration-none" %></td>
            <td><%= permitted_link_to sale.customer.display_name, customer_path(sale.customer) %></td>
            <td><%= tag.code(sale.customer.account_no) %></td>
            <td class="small"><%= sale.vehicle_label.presence || "—" %></td>
            <td><%= qm_date(@agreed_dates[sale.id]) %></td>
            <td class="text-end"><%= money(sale.total_amount) %></td>
            <td class="text-end"><%= money(sale.paid_amount) %></td>
            <td class="text-end fw-semibold"><%= money(sale.balance) %></td>
            <td>
              <% if sale.overdue_amount.to_d.positive? %>
                <%= status_badge("overdue") %>
              <% elsif sale.balance.to_d.positive? %>
                <%= status_badge("partial") %>
              <% else %>
                <%= status_badge("paid") %>
              <% end %>
            </td>
            <td class="text-end">
              <%= permitted_link_to "Record", new_credit_recovery_path(customer_id: sale.customer_id, sale_id: sale.id),
                          class: "btn btn-sm btn-outline-primary" %>
            </td>
          </tr>
        <% end %>
        <% if @plans.empty? %>
          <tr><td colspan="10" class="text-center text-muted py-4">No financed sale is outstanding.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>Date</th><th class="text-end">Amount</th><th>Mode</th><th>Remarks</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        <% @recoveries.each do |recovery| %>
          <tr>
            <td><%= qm_date(recovery.recovery_date) %></td>
            <td class="text-end"><%= money(recovery.amount) %></td>
            <td><%= recovery.payment_mode&.name || "—" %></td>
            <td class="small"><%= recovery.remarks.presence || recovery.reference.presence || "—" %></td>
            <td class="text-end">
              <%= permitted_button_to credit_recovery_path(recovery), method: :delete, title: "Delete",
                            class: "btn btn-sm btn-outline-danger d-inline-block",
                            form: { class: "d-inline", data: { confirm: "Delete this recovery entry?" } } do %><i class="bi bi-trash me-1"></i>Delete<% end %>
            </td>
          </tr>
        <% end %>
        <% if @recoveries.empty? %>
          <tr><td colspan="5" class="text-center text-muted py-4">No recoveries recorded.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
