<%= page_header "Record Recovery", subtitle: "Log money collected in the field", icon: "bi-shield-check" do %>
  <%= permitted_link_to "Back", credit_recoveries_path, class: "btn btn-light" %>
<% end %>

<%= permitted_form_with model: @recovery, url: credit_recoveries_path, method: :post, local: true do |f| %>
  <% if @recovery.errors.any? %>
    <div class="alert alert-danger"><%= @recovery.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Sale *</label>
          <%= f.select :sale_id, @sales.map { |s| ["#{s.sale_no} — #{s.customer.display_name} (#{money(s.balance)})", s.id] },
                       { include_blank: "Select sale", selected: params[:sale_id] }, class: "form-select" %>
        </div>
        <div class="col-md-3"><label class="form-label">Recovery date *</label><%= f.date_field :recovery_date, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Amount *</label><%= f.number_field :amount, step: "0.01", min: 0, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Agreed delivery date</label><%= f.date_field :agreed_date, class: "form-control" %></div>
        <div class="col-md-3">
          <label class="form-label">Payment mode</label>
          <%= f.select :payment_mode_id, @payment_modes.map { |m| [m.name, m.id] }, { include_blank: "—" }, class: "form-select" %>
        </div>
        <div class="col-md-4"><label class="form-label">Reference</label><%= f.text_field :reference, class: "form-control" %></div>
        <div class="col-12"><label class="form-label">Remarks</label><%= f.text_area :remarks, rows: 2, class: "form-control" %></div>
      </div>
      <p class="text-muted small mb-0 mt-3"><i class="bi bi-info-circle me-1"></i>The amount is posted against the oldest unpaid installments and written to the cash book.</p>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between">
      <%= permitted_link_to "Cancel", credit_recoveries_path, class: "btn btn-light" %>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>Record recovery</button>
    </div>
  </div>
<% end %>
