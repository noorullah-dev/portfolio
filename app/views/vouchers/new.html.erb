<%= page_header "New #{@voucher.kind.humanize} Voucher",
              subtitle: "Posts to the ledger and the cash book immediately",
              icon: "bi-file-earmark-plus" do %>
  <%= permitted_link_to "Back", vouchers_path, class: "btn btn-light" %>
<% end %>

<%= permitted_form_with model: @voucher, url: vouchers_path, method: :post, local: true do |f| %>
  <% if @voucher.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0"><% @voucher.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3">
          <label class="form-label">Type *</label>
          <%= f.select :kind, [%w[Receipt receipt], %w[Payment payment]], {}, class: "form-select", id: "voucher_kind" %>
        </div>
        <div class="col-md-3">
          <label class="form-label">Date *</label>
          <%= f.date_field :voucher_date, class: "form-control" %>
        </div>
        <div class="col-md-3">
          <label class="form-label">Party type</label>
          <%= f.select :party_type, [%w[Customer Customer], %w[Supplier Supplier], ["Other", "Other"]], {}, class: "form-select", id: "voucher_party_type" %>
        </div>
        <div class="col-md-3">
          <label class="form-label">Party</label>
          <%= f.select :party_id, options_for_select(@parties.values.flatten(1)), { include_blank: "—" }, class: "form-select", id: "voucher_party_id" %>
        </div>

        <div class="col-md-3">
          <label class="form-label">Amount *</label>
          <%= f.number_field :amount, step: "0.01", min: 0, class: "form-control", required: true, autofocus: true %>
        </div>
        <div class="col-md-3">
          <label class="form-label">Payment mode</label>
          <%= f.select :payment_mode_id, @payment_modes.map { |m| [m.name, m.id] }, { include_blank: "—" }, class: "form-select" %>
        </div>
        <div class="col-md-3">
          <label class="form-label">Ledger account</label>
          <%= f.select :account_id, @accounts, { include_blank: "Default (receivable / payable)" }, class: "form-select" %>
        </div>
        <div class="col-md-3">
          <label class="form-label">Reference</label>
          <%= f.text_field :reference, class: "form-control" %>
        </div>
        <div class="col-12">
          <label class="form-label">Remarks</label>
          <%= f.text_area :remarks, rows: 2, class: "form-control" %>
        </div>
      </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between">
      <%= permitted_link_to "Cancel", vouchers_path, class: "btn btn-light" %>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>Record voucher</button>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var type = document.getElementById("voucher_party_type");
    var party = document.getElementById("voucher_party_id");
    var options = <%= raw @parties.to_json %>;

    function refresh() {
      var list = options[type.value] || [];
      party.innerHTML = '<option value="">—</option>' + list.map(function (row) {
        return '<option value="' + row[1] + '">' + row[0] + '</option>';
      }).join("");
    }

    if (type && party) { type.addEventListener("change", refresh); refresh(); }
  });
</script>
