<% kind = @kind || params[:kind] || "receipt" %>
<%= page_header kind == "receipt" ? "Receipt Vouchers" : "Payment Vouchers",
              subtitle: kind == "receipt" ? "Money received outside the installment screen" : "Money paid out",
              icon: kind == "receipt" ? "bi-arrow-down-circle" : "bi-arrow-up-circle" do %>
  <div class="d-flex gap-2">
    <%= permitted_link_to new_receipt_voucher_path, class: "btn btn-outline-success" do %><i class="bi bi-plus-lg me-1"></i>Receipt<% end %>
    <%= permitted_link_to new_payment_voucher_path, class: "btn btn-outline-danger" do %><i class="bi bi-plus-lg me-1"></i>Payment<% end %>
  </div>
<% end %>

<% if action_name == "index" && @summary %>
  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <div class="card"><div class="card-body d-flex align-items-center gap-3">
        <div class="rounded-circle bg-success-subtle text-success p-2"><i class="bi bi-arrow-down-circle"></i></div>
        <div><div class="text-muted small">Received (30 days)</div><div class="fs-5 fw-semibold"><%= money(@summary[:receipts]) %></div></div>
      </div></div>
    </div>
    <div class="col-md-6">
      <div class="card"><div class="card-body d-flex align-items-center gap-3">
        <div class="rounded-circle bg-danger-subtle text-danger p-2"><i class="bi bi-arrow-up-circle"></i></div>
        <div><div class="text-muted small">Paid out (30 days)</div><div class="fs-5 fw-semibold"><%= money(@summary[:payments]) %></div></div>
      </div></div>
    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="fw-semibold small text-secondary"><%= @vouchers.total_count %> voucher(s)</span>
    <%= permitted_form_with url: request.path, method: :get, local: true, class: "d-flex gap-2 flex-wrap qm-toolbar" do %>
      <%= text_field_tag :q, params[:q], class: "form-control form-control-sm", placeholder: "Search number, party or reference" %>
      <%= select_tag :kind, options_for_select([["All kinds", ""], %w[Receipt receipt], %w[Payment payment]], params[:kind]), class: "form-select form-select-sm" %>
      <%= date_field_tag :from, params[:from], class: "form-control form-control-sm" %>
      <%= date_field_tag :to, params[:to], class: "form-control form-control-sm" %>
      <%= submit_tag "Filter", class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>Number</th><th>Date</th><th>Party</th><th>Mode</th><th>Reference</th><th class="text-end">Amount</th><th></th></tr></thead>
      <tbody>
        <% @vouchers.each do |voucher| %>
          <tr>
            <td><%= permitted_link_to voucher.voucher_no, voucher_path(voucher), class: "fw-semibold text-decoration-none" %></td>
            <td><%= qm_date(voucher.voucher_date) %></td>
            <td>
              <%= voucher.party_name.presence || "—" %>
              <div class="small text-muted"><%= voucher.party_type %></div>
            </td>
            <td><%= voucher.payment_mode&.name || "—" %></td>
            <td><%= voucher.reference.presence || "—" %></td>
            <td class="text-end <%= voucher.receipt? ? 'text-success' : 'text-danger' %>"><%= money(voucher.amount) %></td>
            <td class="text-end"><%= permitted_link_to voucher_path(voucher), class: "btn btn-sm btn-outline-secondary" do %><i class="bi bi-eye"></i><% end %></td>
          </tr>
        <% end %>
        <% if @vouchers.empty? %>
          <tr><td colspan="7" class="text-center text-muted py-4">No vouchers found.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
