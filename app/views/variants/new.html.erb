<%= page_header "New Variant", subtitle: "Add a model or trim level to a product", icon: "bi-sliders" do %>
  <%= permitted_link_to "Back", variants_path, class: "btn btn-light" %>
<% end %>

<%= permitted_form_with model: @variant, url: variants_path, method: :post, local: true do |f| %>
  <% if @variant.errors.any? %>
    <div class="alert alert-danger"><%= @variant.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="card"><div class="card-body">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Product *</label>
        <%= f.select :product_id, @products.map { |p| [p.display_name, p.id] }, { include_blank: "Select product", selected: @variant.product_id }, class: "form-select" %>
      </div>
      <div class="col-md-3"><label class="form-label">Attribute name</label><%= f.text_field :attribute_name, class: "form-control" %></div>
      <div class="col-md-3"><label class="form-label">Value *</label><%= f.text_field :value, class: "form-control", placeholder: "GLi" %></div>
      <div class="col-md-3"><label class="form-label">Purchase price</label><%= f.number_field :purchase_price, step: "0.01", min: 0, class: "form-control" %></div>
      <div class="col-md-3"><label class="form-label">Sale price</label><%= f.number_field :sale_price, step: "0.01", min: 0, class: "form-control" %></div>
      <div class="col-md-3">
        <label class="form-label">Status</label>
        <%= f.select :status, %w[active inactive], {}, class: "form-select" %>
      </div>
    </div>
  </div>
  <div class="card-footer bg-white d-flex justify-content-between">
    <%= permitted_link_to "Cancel", variants_path, class: "btn btn-light" %>
    <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>Create variant</button>
  </div></div>
<% end %>
