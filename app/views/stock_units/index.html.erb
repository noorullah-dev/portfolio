<%= page_header "Stock / Vehicles", subtitle: "Every vehicle in stock and its status", icon: "bi-box-seam" do %>
  <%= permitted_link_to new_purchase_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i>New Purchase<% end %>
<% end %>

<div class="row g-3 mb-3">
  <% [
    ["Total vehicles", @summary[:total], "bi-boxes"],
    ["Available", @summary[:available], "bi-check-circle"],
    ["Sold", @summary[:sold], "bi-bag-check"],
    ["Stock value", money(@summary[:value]), "bi-cash-stack"]
  ].each_with_index do |(label, value, icon), index| %>
    <div class="col-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <div class="rounded-circle p-2 <%= index == 2 ? 'bg-secondary-subtle text-secondary' : 'bg-primary-subtle text-primary' %>">
            <i class="bi <%= icon %>"></i>
          </div>
          <div>
            <div class="text-muted small"><%= label %></div>
            <div class="fs-5 fw-semibold"><%= value %></div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="card">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="fw-semibold small text-secondary"><%= @stock_units.size %> vehicle(s)</span>
    <%= permitted_form_with url: stock_units_path, method: :get, local: true, class: "d-flex gap-2 flex-wrap qm-toolbar" do %>
      <%= text_field_tag :q, params[:q], class: "form-control form-control-sm qm-search",
                          placeholder: "Search engine, chassis, model" %>
      <%= select_tag :status, options_for_select([["All statuses", ""], %w[Available available],
                                                    %w[Sold sold], %w[Reserved reserved]], params[:status]),
                     class: "form-select form-select-sm" %>
      <%= submit_tag "Filter", class: "btn btn-sm btn-outline-secondary" %>
      <%= permitted_link_to "Reset", stock_units_path, class: "btn btn-sm btn-light" %>
    <% end %>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th class="text-end">#</th><th>Brand / Model</th><th>Variant</th><th>Purchase No</th>
            <th>Engine No</th><th>Chassis No</th><th>Challan No</th><th>Reg No</th><th>Biometric</th>
            <th>Serial No</th><th>Warranty</th><th>Status</th><th>Date Added</th><th class="text-end">Edit</th></tr>
      </thead>
      <tbody>
        <% @stock_units.each do |unit| %>
          <tr>
            <td class="text-end text-secondary"><%= unit.id %></td>
            <td>
              <%= permitted_link_to unit.label, stock_unit_path(unit), class: "fw-semibold text-decoration-none" %>
              <% if unit.supplier %><div class="small text-muted"><%= unit.supplier.name %></div><% end %>
            </td>
            <td class="small"><%= unit.variant&.value.presence || "—" %></td>
            <td><%= unit.purchase ? permitted_link_to(unit.purchase.purchase_no, purchase_path(unit.purchase)) : "—" %></td>
            <td class="small"><%= unit.engine_no.presence || "—" %></td>
            <td class="small"><%= unit.chassis_no.presence || "—" %></td>
            <td class="small"><%= unit.challan_no.presence || "—" %></td>
            <td class="small"><%= unit.reg_no.presence || "—" %></td>
            <td><%= unit.biometric ? status_badge("received") : status_badge("pending") %></td>
            <td class="small"><%= unit.serial_no.presence || "—" %></td>
            <td class="small"><%= unit.warranty_months.to_i.positive? ? "#{unit.warranty_months} mo" : "—" %></td>
            <td><%= status_badge(unit.status) %></td>
            <td><%= qm_date(unit.date_added) %></td>
            <td class="text-end text-nowrap">
              <%= permitted_link_to edit_stock_unit_path(unit), class: "btn btn-sm btn-outline-primary", title: "Edit" do %><i class="bi bi-pencil"></i><% end %>
            </td>
          </tr>
        <% end %>
        <% if @stock_units.empty? %>
          <tr><td colspan="14" class="text-center text-muted py-4"><i class="bi bi-inbox me-2"></i>No vehicles in stock.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>