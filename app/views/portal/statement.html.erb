<% content_for :title, "My Statement" %>
<div class="qm-page">
  <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h1 class="h4 mb-1">Account statement</h1>
      <p class="text-muted mb-0"><%= @customer.name %> &middot; <%= @customer.account_no %> &middot; generated <%= Date.current %></p>
    </div>
    <%= permitted_link_to "Back to my account", customer_portal_path, class: "btn btn-link" %>
  </div>

  <div class="card mb-3">
    <div class="card-header bg-transparent fw-semibold">Purchases</div>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th>Sale no</th><th>Date</th><th>Payment mode</th><th class="text-end">Total</th><th class="text-end">Paid at sale</th><th class="text-end">Financed</th></tr></thead>
        <tbody>
          <% @sales.each do |sale| %>
            <tr>
              <td><%= sale.sale_no %></td>
              <td><%= sale.sale_date %></td>
              <td><%= sale.payment_mode&.name || "—" %></td>
              <td class="text-end"><%= number_to_currency(sale.total_amount) %></td>
              <td class="text-end"><%= number_to_currency(sale.paid_amount) %></td>
              <td class="text-end"><%= number_to_currency(sale.balance) %></td>
            </tr>
          <% end %>
          <% if @sales.empty? %><tr><td colspan="6" class="text-muted">No purchases recorded.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header bg-transparent fw-semibold">Payments received</div>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th>Date</th><th>Mode</th><th>Reference</th><th class="text-end">Amount</th></tr></thead>
        <tbody>
          <% @payments.each do |p| %>
            <tr>
              <td><%= p.payment_date %></td>
              <td><%= p.payment_mode&.name || "—" %></td>
              <td><%= p.reference.presence || "—" %></td>
              <td class="text-end text-success"><%= number_to_currency(p.amount) %></td>
            </tr>
          <% end %>
          <% if @payments.empty? %><tr><td colspan="4" class="text-muted">No payments recorded.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-transparent fw-semibold">Instalment schedule</div>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th>#</th><th>Sale</th><th>Due</th><th class="text-end">Amount</th><th class="text-end">Paid</th><th class="text-end">Remaining</th><th>Status</th></tr></thead>
        <tbody>
          <% @plans.each_with_index do |plan, i| %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= plan.sale&.sale_no %></td>
              <td><%= plan.due_date %></td>
              <td class="text-end"><%= number_to_currency(plan.amount) %></td>
              <td class="text-end"><%= number_to_currency(plan.paid_amount) %></td>
              <td class="text-end"><%= number_to_currency(plan.remaining) %></td>
              <td><%= status_badge(plan.status) %></td>
            </tr>
          <% end %>
          <% if @plans.empty? %><tr><td colspan="7" class="text-muted">No instalment plans.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
