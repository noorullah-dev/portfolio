<% content_for :title, @log.action %>
<div class="qm-page" style="max-width:820px">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h1 class="h5 mb-1"><%= @log.action %></h1>
      <p class="text-muted mb-0"><%= @log.created_at.strftime("%d %b %Y %H:%M:%S") %> &middot; <%= @log.user&.username || "system" %></p>
    </div>
    <%= permitted_link_to "Back to log", audit_logs_path, class: "btn btn-link" %>
  </div>

  <div class="card"><div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Summary</dt><dd class="col-sm-9"><%= @log.summary %></dd>
      <dt class="col-sm-3">Role</dt><dd class="col-sm-9"><%= @log.role || "—" %></dd>
      <dt class="col-sm-3">Record</dt><dd class="col-sm-9"><%= @log.record_type %> #<%= @log.record_id %></dd>
      <dt class="col-sm-3">Branch</dt><dd class="col-sm-9"><%= @log.branch&.name || "—" %></dd>
      <dt class="col-sm-3">Request</dt><dd class="col-sm-9"><%= @log.request_method %> <%= @log.request_path %></dd>
      <dt class="col-sm-3">IP</dt><dd class="col-sm-9"><%= @log.ip_address || "—" %></dd>
    </dl>
  </div></div>

  <% if @log.detail.present? %>
    <div class="card mt-3">
      <div class="card-header bg-transparent fw-semibold">Change set</div>
      <div class="card-body"><pre class="mb-0 small"><%= JSON.pretty_generate(@log.detail) %></pre></div>
    </div>
  <% end %>
</div>
