<%= page_header "Business Settings", subtitle: "Company details used on receipts and reports", icon: "bi-gear" do %>
  <%= permitted_link_to "Back", root_path, class: "btn btn-light" %>
<% end %>

<%= permitted_form_with model: @business, url: business_settings_path, method: :patch, local: true, multipart: true do |f| %>
  <% if @business.errors.any? %>
    <div class="alert alert-danger"><%= @business.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="row g-3">
    <div class="col-lg-6">
      <div class="card h-100">
        <div class="card-header bg-white fw-semibold">Identity</div>
        <div class="card-body">
          <div class="mb-3"><label class="form-label">Business name *</label><%= f.text_field :name, class: "form-control" %></div>
          <div class="mb-3">
            <label class="form-label">Business type *</label>
            <%= f.select :business_type, Business::BUSINESS_TYPES.map { |value, label| [label, value] },
                        { include_blank: "Select business type" }, class: "form-select" %>
          </div>
          <div class="row g-3">
            <div class="col-6"><label class="form-label">Phone</label><%= f.text_field :phone, class: "form-control" %></div>
            <div class="col-6"><label class="form-label">Email</label><%= f.email_field :email, class: "form-control" %></div>
            <div class="col-6"><label class="form-label">City</label><%= f.text_field :city, class: "form-control" %></div>
            <div class="col-6"><label class="form-label">CNIC</label><%= f.text_field :cnic, class: "form-control" %></div>
            <div class="col-6"><label class="form-label">NTN</label><%= f.text_field :ntn, class: "form-control" %></div>
            <div class="col-6"><label class="form-label">Currency symbol</label><%= f.text_field :currency, class: "form-control", placeholder: "Rs." %></div>
          </div>
          <div class="mt-3">
            <label class="form-label">Logo</label>
            <div class="d-flex align-items-center gap-3">
              <img src="<%= @business.logo_path %>" alt="Business logo" class="border rounded bg-white" style="max-height:56px;max-width:110px;object-fit:contain">
              <%= f.file_field :logo, class: "form-control", accept: "image/*" %>
            </div>
            <div class="form-text">Shown on the sidebar-free print headers and receipts.</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card h-100">
        <div class="card-header bg-white fw-semibold">Address</div>
        <div class="card-body">
          <div class="mb-3"><label class="form-label">Address</label><%= f.text_area :address, rows: 4, class: "form-control" %></div>
          <div class="mb-3">
            <label class="form-label">Footer text for prints</label>
            <%= f.text_field :footer_text, maxlength: 500, class: "form-control", placeholder: "e.g. Thank you for your business!" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header bg-white fw-semibold">Finance and stock defaults</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Default installment day</label><%= f.number_field :default_installment_day, min: 1, max: 28, class: "form-control" %></div>
        <div class="col-md-3">
          <label class="form-label">Late fee rule</label>
          <%= f.select :late_fee_type, [%w[None none], %w[Percent percent], %w[Fixed fixed]], {}, class: "form-select" %>
        </div>
        <div class="col-md-3"><label class="form-label">Late fee amount</label><%= f.number_field :late_fee_amount, step: "0.01", min: 0, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Low stock alert</label><%= f.number_field :low_stock_alert, min: 0, class: "form-control" %></div>
        <div class="col-12">
          <div class="form-check form-switch">
            <%= f.check_box :allow_negative_stock, class: "form-check-input" %>
            <label class="form-check-label" for="business_allow_negative_stock">Allow selling below recorded stock</label>
          </div>
        </div>
      </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between">
      <span class="small text-muted align-self-center">Payment modes are managed in the database seed list.</span>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>Save settings</button>
    </div>
  </div>
<% end %>
