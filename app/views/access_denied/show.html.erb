<% content_for :title, "Access denied" %>
<div class="qm-page" style="max-width:640px">
  <div class="card">
    <div class="card-body text-center py-5">
      <div class="display-6 mb-2">&#128683;</div>
      <h1 class="h5 mb-2">You do not have access to this page</h1>
      <p class="text-muted mb-4">
        Your role (<%= current_user&.display_role %>) does not include this permission.
        Ask your shop administrator if you need it.
      </p>
      <div class="d-flex gap-2 justify-content-center">
        <%= permitted_link_to "Back to dashboard", current_user&.customer_portal? ? customer_portal_path : root_path, class: "btn btn-primary" %>
        <%= permitted_link_to "Sign out", logout_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>
