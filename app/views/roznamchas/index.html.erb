<%= page_header "Roznamcha (Reminder Letters)", subtitle: "Overdue installments between two dates", icon: "bi-envelope-paper" do %>
  <button class="btn btn-light" type="button" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
<% end %>

<%= permitted_form_with url: roznamcha_path, method: :get, local: true, class: "no-print d-flex gap-2 align-items-end flex-wrap mb-3" do %>
  <div><label class="form-label small mb-0">From</label><input type="date" name="from" value="<%= @from %>" class="form-control form-control-sm"></div>
  <div><label class="form-label small mb-0">To</label><input type="date" name="to" value="<%= @to %>" class="form-control form-control-sm"></div>
  <button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-search me-1"></i>Apply</button>
<% end %>

<div class="row g-3 mb-3">
  <div class="col-md-4"><div class="card"><div class="card-body">
    <div class="text-muted small">Letters needed</div><div class="fs-4 fw-semibold"><%= @rows.size %></div>
  </div></div></div>
  <div class="col-md-4"><div class="card"><div class="card-body">
    <div class="text-muted small">Total overdue</div><div class="fs-4 fw-semibold text-danger"><%= money(@total) %></div>
  </div></div></div>
  <div class="col-md-4"><div class="card"><div class="card-body">
    <div class="text-muted small">Customers involved</div><div class="fs-4 fw-semibold"><%= @customers.size %></div>
  </div></div></div>
</div>

<% if @customers.any? %>
  <div class="card mb-3">
    <div class="card-header bg-white fw-semibold">Customer summary</div>
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Customer</th><th>Phone</th><th class="text-end">Outstanding</th><th class="text-end">Letters</th><th class="text-end"></th></tr></thead>
        <tbody>
          <% @customers.each do |customer, amount| %>
            <tr>
              <td><%= permitted_link_to customer.display_name, customer_path(customer) %></td>
              <td class="small text-secondary"><%= customer.phone.presence || "—" %></td>
              <td class="text-end text-danger"><%= money(amount) %></td>
              <td class="text-end"><%= @rows.count { |row| row[:customer] == customer } %></td>
              <td class="text-end">
                <% sale = customer.active_sales.first %>
                <% if sale %>
                  <%= permitted_link_to "Collect", new_sale_payment_path(sale), class: "btn btn-sm btn-outline-primary" %>
                <% else %>
                  <%= permitted_link_to "Open", customer_path(customer), class: "btn btn-sm btn-outline-secondary" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-header bg-white fw-semibold">Detailed letters</div>
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-light"><tr><th class="text-end">No</th><th>Customer Name</th><th>Phone</th><th>Address</th><th>Product / Color</th><th>Engine / Serial No</th><th>Due Month</th><th class="text-end">Monthly Amount</th><th class="text-end">Short Pending</th><th class="text-end">Total Due</th><th class="text-end">Amount Collected</th><th>Remarks</th><th>Signature</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        <% @rows.each do |row| %>
          <tr>
            <td class="text-end text-secondary"><%= row[:plan].installment_no %></td>
            <td><%= permitted_link_to row[:customer].display_name, customer_path(row[:customer]) %></td>
            <td class="small"><%= row[:customer].phone.presence || "—" %></td>
            <td class="small"><%= row[:customer].address.presence || "—" %></td>
            <td class="small"><%= row[:sale].vehicle_label.presence || "—" %></td>
            <td class="small"><%= row[:sale].stock_unit&.engine_no.presence || row[:sale].stock_unit&.serial_no.presence || "—" %></td>
            <td><%= row[:plan].due_date.strftime("%b %Y") %></td>
            <td class="text-end"><%= money(row[:plan].amount) %></td>
            <td class="text-end"><%= money(row[:plan].short_amount) %></td>
            <td class="text-end text-danger"><%= money(row[:remaining]) %></td>
            <td class="text-end"><%= money(row[:plan].paid_amount) %></td>
            <td class="small"><%= row[:days_overdue] %> d overdue</td>
            <td class="text-secondary"></td>
            <td class="text-end">
              <%= permitted_form_with url: installment_reminder_path(row[:plan]), method: :post, local: true, class: "d-inline",
                            data: { turbo: false } do |f| %>
                <input type="hidden" name="return_to" value="<%= roznamcha_path %>">
                <select name="channel" class="form-select form-select-sm d-inline-block w-auto">
                  <% InstallmentReminder::CHANNELS.each do |channel| %><option value="<%= channel %>"><%= channel.titleize %></option><% end %>
                </select>
                <button class="btn btn-sm btn-outline-primary" type="submit">Send</button>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @rows.empty? %>
          <tr><td colspan="14" class="text-center text-muted py-4">Nothing overdue in this period.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
