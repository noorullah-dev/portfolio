<%= permitted_form_with model: branch, url: branch.persisted? ? branch_path(branch) : branches_path,
      method: branch.persisted? ? :patch : :post, local: true do |f| %>
  <% if branch.errors.any? %>
    <div class="alert alert-danger"><ul class="mb-0"><% branch.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
  <% end %>
  <div class="row g-3">
    <div class="col-md-8"><%= f.label :name, class: "form-label" %><%= f.text_field :name, class: "form-control", required: true %></div>
    <div class="col-md-4"><%= f.label :code, class: "form-label" %><%= f.text_field :code, class: "form-control" %></div>
    <div class="col-md-4">
      <%= f.label :branch_type, class: "form-label" %>
      <%= f.select :branch_type, Branch::TYPES.map { |t| [t.humanize, t] }, {}, class: "form-select" %>
    </div>
    <div class="col-md-4">
      <%= f.label :status, class: "form-label" %>
      <%= f.select :status, [%w[Active active], %w[Suspended suspended]], {}, class: "form-select" %>
    </div>
    <div class="col-md-4 d-flex align-items-end">
      <div class="form-check">
        <%= f.check_box :is_default, class: "form-check-input" %>
        <%= f.label :is_default, "Main branch of this shop", class: "form-check-label" %>
      </div>
    </div>
    <div class="col-md-8"><%= f.label :address, class: "form-label" %><%= f.text_field :address, class: "form-control" %></div>
    <div class="col-md-4"><%= f.label :city, class: "form-label" %><%= f.text_field :city, class: "form-control" %></div>
    <div class="col-md-4"><%= f.label :phone, class: "form-label" %><%= f.text_field :phone, class: "form-control" %></div>
    <div class="col-12">
      <%= render "shared/permission_picker", title: "Branch staff permissions", prefix: "branch", attribute: "allowed_permissions",
            custom: !branch.allowed_permissions.nil?, selected: branch.allowed_permissions || Permissions::STAFF_PERMISSIONS,
            default_label: "No branch limit",
            description: "Limit which actions staff assigned to this branch may use. A staff member must also have the action in their role or individual permissions. Shop admins keep access to every branch." %>
    </div>
    <div class="col-12 d-flex gap-2 mt-4">
      <%= f.submit branch.persisted? ? "Save branch" : "Create branch", class: "btn btn-primary" %>
      <%= permitted_link_to "Cancel", branches_path, class: "btn btn-link" %>
    </div>
  </div>
<% end %>
