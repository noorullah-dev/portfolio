<%# Owner-only: open a shop to work inside it with full permissions, or drop
    back to the platform-wide view. %>
<% if owner? %>
  <div class="dropdown">
    <button class="user-pill dropdown-toggle qm-shop-switcher" type="button" id="shopSwitcherDropdown"
            data-bs-toggle="dropdown" aria-expanded="false" title="Switch shop">
      <i class="bi bi-buildings"></i>
      <span class="user-pill-name d-none d-sm-inline"><%= owner_shop&.name || "Platform view" %></span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="shopSwitcherDropdown">
      <li class="dropdown-header">Open a shop</li>
      <% Business.order(:name).each do |shop| %>
        <li>
          <%= button_to open_owner_business_path(shop), method: :post,
                        class: "dropdown-item#{' active' if owner_shop&.id == shop.id}" do %>
            <i class="bi bi-buildings me-2"></i><%= shop.name %>
            <% if owner_shop&.id == shop.id %><i class="bi bi-check-lg ms-auto"></i><% end %>
          <% end %>
        </li>
      <% end %>
      <% if owner_shop %>
        <li><hr class="dropdown-divider"></li>
        <li>
          <%= button_to close_owner_business_path, method: :delete, class: "dropdown-item" do %>
            <i class="bi bi-globe-americas me-2"></i>Platform view (all shops)
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
