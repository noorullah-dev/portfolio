<%# Appearance switcher: colour scheme, accent palette and density.
    Persisted in localStorage so it applies on every page without a reload. %>
<div class="dropdown qm-theme-menu">
  <button class="topbar-icon-btn" type="button" id="themeToggleBtn"
          data-bs-toggle="dropdown" aria-expanded="false" title="Appearance">
    <i class="bi bi-palette" id="themeToggleIcon"></i>
  </button>

  <div class="dropdown-menu dropdown-menu-end p-0 qm-theme-panel" aria-labelledby="themeToggleBtn">
    <div class="qm-theme-head">
      <i class="bi bi-palette"></i>
      <div>
        <div class="qm-theme-title">Appearance</div>
        <div class="qm-theme-sub">Saved on this device</div>
      </div>
    </div>

    <div class="qm-theme-body">
      <div class="qm-theme-label">Colour scheme</div>
      <div class="qm-theme-opts" role="group" aria-label="Colour scheme">
        <button type="button" class="qm-theme-opt" data-theme-set="light">
          <i class="bi bi-sun"></i><span>Light</span>
        </button>
        <button type="button" class="qm-theme-opt" data-theme-set="dark">
          <i class="bi bi-moon-stars"></i><span>Dark</span>
        </button>
        <button type="button" class="qm-theme-opt" data-theme-set="auto">
          <i class="bi bi-circle-half"></i><span>Auto</span>
        </button>
      </div>

      <div class="qm-theme-label">Accent colour</div>
      <div class="qm-swatches" role="group" aria-label="Accent colour">
        <% %w[indigo blue sky teal emerald amber rose violet slate].each do |accent| %>
          <button type="button" class="qm-swatch" data-accent-set="<%= accent %>"
                  style="--swatch: var(--sw-<%= accent %>)" title="<%= accent.titleize %>"
                  aria-label="<%= accent.titleize %> accent"></button>
        <% end %>
      </div>

      <div class="qm-theme-label">Density</div>
      <div class="qm-theme-opts" role="group" aria-label="Density">
        <button type="button" class="qm-theme-opt" data-density-set="comfortable">
          <i class="bi bi-arrows-angle-expand"></i><span>Comfortable</span>
        </button>
        <button type="button" class="qm-theme-opt" data-density-set="compact">
          <i class="bi bi-arrows-collapse"></i><span>Compact</span>
        </button>
      </div>

      <button type="button" class="qm-theme-reset" id="qmThemeReset">
        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to default
      </button>
    </div>
  </div>
</div>
