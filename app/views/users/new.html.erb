<%= page_header "New User", subtitle: "Create a sign-in account", icon: "bi-person-plus" do %>
  <%= permitted_link_to "Back", users_path, class: "btn btn-light" %>
<% end %>

<%= permitted_form_with model: @user, url: users_path, method: :post, local: true do |f| %>
  <% if @user.errors.any? %>
    <div class="alert alert-danger"><%= @user.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="card"><div class="card-body">
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label">Full name *</label><%= f.text_field :full_name, class: "form-control" %></div>
      <div class="col-md-6"><label class="form-label">Username *</label><%= f.text_field :username, class: "form-control" %></div>
      <div class="col-md-6"><label class="form-label">Phone</label><%= f.text_field :phone, class: "form-control" %></div>
      <div class="col-md-3">
        <label class="form-label">Role</label>
        <%= f.select :role, User::ROLES.reject { |r| r == "owner" }.map { |r| [r.titleize, r] }, {}, class: "form-select" %>
      </div>
      <div class="col-md-3">
        <label class="form-label">Status</label>
        <%= f.select :status, %w[active inactive], {}, class: "form-select" %>
      </div>
      <div class="col-md-6"><label class="form-label">Password</label><%= f.password_field :password, class: "form-control", autocomplete: "new-password" %></div>
      <div class="col-md-6"><label class="form-label">Confirm password</label><%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %></div>
      <%= render "access_fields", f: f %>
    </div>
  </div>
  <div class="card-footer bg-white d-flex justify-content-between">
    <%= permitted_link_to "Cancel", users_path, class: "btn btn-light" %>
    <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>Create user</button>
  </div></div>
<% end %>
