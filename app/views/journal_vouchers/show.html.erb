<%= page_header "Journal #{@voucher.voucher_no}",
              subtitle: "#{qm_date(@voucher.voucher_date)} · #{@voucher.description.presence || 'Journal entry'}",
              icon: "bi-journal-text" do %>
  <div class="d-flex gap-2">
    <% unless @voucher.posted? %>
      <%= permitted_button_to "Post to ledger", post_voucher_journal_voucher_path(@voucher), method: :patch,
                    class: "btn btn-primary", form: { class: "d-inline" } %>
      <%= permitted_link_to edit_journal_voucher_path(@voucher), class: "btn btn-outline-primary" do %><i class="bi bi-pencil me-1"></i>Edit<% end %>
    <% end %>
    <%= permitted_link_to "Back", journal_vouchers_path, class: "btn btn-light" %>
  </div>
<% end %>

<% if @voucher.errors.any? %>
  <div class="alert alert-danger"><%= @voucher.errors.full_messages.to_sentence %></div>
<% end %>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Voucher lines</span>
        <span>
          <span class="badge bg-light text-dark">Debit <%= money(@voucher.total_debit) %></span>
          <span class="badge bg-light text-dark">Credit <%= money(@voucher.total_credit) %></span>
          <% if @voucher.balanced? %>
            <span class="badge bg-success">Balanced</span>
          <% else %>
            <span class="badge bg-danger">Out of balance</span>
          <% end %>
        </span>
      </div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light"><tr><th>#</th><th>Account</th><th>Particulars</th><th class="text-end">Debit</th><th class="text-end">Credit</th></tr></thead>
          <tbody>
            <% @voucher.lines.order(:id).each_with_index do |line, index| %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= line.account&.to_s %></td>
                <td><%= line.remarks.presence || "—" %></td>
                <td class="text-end"><%= line.debit.to_d.positive? ? money(line.debit) : "—" %></td>
                <td class="text-end"><%= line.credit.to_d.positive? ? money(line.credit) : "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header bg-white fw-semibold">Status</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5 text-secondary small">Status</dt><dd class="col-7"><%= status_badge(@voucher.status) %></dd>
          <dt class="col-5 text-secondary small">Posted at</dt><dd class="col-7"><%= @voucher.posted_at ? l(@voucher.posted_at, format: :short) : "—" %></dd>
          <dt class="col-5 text-secondary small">Posted by</dt><dd class="col-7"><%= @voucher.posted_by&.full_name || "—" %></dd>
          <dt class="col-5 text-secondary small">Reference</dt><dd class="col-7"><%= @voucher.reference.presence || "—" %></dd>
        </dl>
      </div>
    </div>

    <% if @ledger_entries.any? %>
      <div class="card mt-3">
        <div class="card-header bg-white fw-semibold">Ledger entries</div>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th>Account</th><th class="text-end">Debit</th><th class="text-end">Credit</th></tr></thead>
            <tbody>
              <% @ledger_entries.each do |entry| %>
                <tr>
                  <td><%= entry.account&.to_s %></td>
                  <td class="text-end"><%= entry.debit.to_d.positive? ? money(entry.debit) : "—" %></td>
                  <td class="text-end"><%= entry.credit.to_d.positive? ? money(entry.credit) : "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
</div>
