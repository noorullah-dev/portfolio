<%= page_header "Close Account", subtitle: "Settle the remaining balance and write off the rest", icon: "bi-check2-square" do %>
  <%= permitted_link_to "Back", account_closures_path, class: "btn btn-light" %>
<% end %>

<%= permitted_form_with model: @closure, url: account_closures_path, method: :post, local: true do |f| %>
  <% if @closure.errors.any? %>
    <div class="alert alert-danger"><%= @closure.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Customer *</label>
          <%= f.select :customer_id, @customers.map { |c| [c.display_name, c.id] }, { include_blank: "Select customer" }, class: "form-select", id: "closure_customer" %>
        </div>
        <div class="col-md-3"><label class="form-label">Date *</label><%= f.date_field :closure_date, class: "form-control" %></div>
        <div class="col-md-2"><label class="form-label">Balance</label><%= f.number_field :remaining_balance, step: "0.01", min: 0, class: "form-control" %></div>
        <div class="col-md-3"><label class="form-label">Settled now</label><%= f.number_field :settled_amount, step: "0.01", min: 0, class: "form-control" %></div>
        <div class="col-md-4"><label class="form-label">Waived</label><%= f.text_field :waived_amount, class: "form-control" %></div>
        <div class="col-12"><label class="form-label">Reason</label><%= f.text_field :reason, class: "form-control" %></div>
      </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between">
      <%= permitted_link_to "Cancel", account_closures_path, class: "btn btn-light" %>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>Close account</button>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var select = document.getElementById("closure_customer");
    if (!select) return;
    select.addEventListener("change", function () {
      var option = select.options[select.selectedIndex];
      if (!option) return;
      var match = option.textContent.match(/\(([^()]*)\)\s*$/);
      if (match) {
        select.form.querySelector("[name='account_closure[remaining_balance]']").value = match[1];
      }
    });
  });
</script>
