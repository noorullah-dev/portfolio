<% content_for :title, @branch.display_name %>
<div class="qm-page">
  <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h1 class="h4 mb-1"><%= @branch.display_name %> <%= status_badge(@branch.status) %></h1>
      <p class="text-muted mb-0"><%= @branch.address.presence || @branch.city.presence || "No address on file" %></p>
    </div>
    <div class="d-flex gap-2">
      <% if can?("branches.edit") %><%= permitted_link_to edit_branch_path(@branch), class: "btn btn-outline-secondary", title: "Edit" do %><i class="bi bi-pencil me-1"></i>Edit<% end %><% end %>
      <%= permitted_link_to "All branches", branches_path, class: "btn btn-link" %>
    </div>
  </div>

  <div class="alert alert-info">
    <strong>Branch permissions:</strong> <%= @branch.allowed_permissions.nil? ? "No branch limit; staff use their role or individual permissions." : "#{@branch.allowed_permissions.size} selected actions, plus dashboard access." %>
    <%= permitted_link_to edit_branch_path(@branch), class: "btn btn-sm btn-outline-primary ms-2", title: "Manage permissions" do %><i class="bi bi-sliders me-1"></i>Manage permissions<% end %>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body">
      <div class="small text-muted">Sales</div><div class="fs-4 fw-semibold"><%= @sales_count %></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body">
      <div class="small text-muted">Staff assigned</div><div class="fs-4 fw-semibold"><%= @staff.size %></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body">
      <div class="small text-muted">Branch type</div><div class="fs-6 fw-semibold mt-1"><%= @branch.branch_type.humanize %></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body">
      <div class="small text-muted">Since</div><div class="fs-6 fw-semibold mt-1"><%= @branch.created_at.to_date %></div></div></div></div>
  </div>

  <div class="card mb-3">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Staff in this branch</span>
      <%= permitted_link_to "Add staff", new_user_path(branch_id: @branch.id), class: "btn btn-sm btn-primary" %>
    </div>
    <ul class="list-group list-group-flush">
      <% if @staff.any? %>
        <% @staff.each do |u| %>
          <li class="list-group-item d-flex justify-content-between">
            <span><%= u.full_name %> <span class="text-muted small">(@<%= u.username %>)</span></span>
            <span><%= u.display_role %> &middot; <%= status_badge(u.status) %>
              <%= permitted_link_to "Permissions & assignment", edit_user_path(u), class: "btn btn-sm btn-outline-primary ms-2" %>
            </span>
          </li>
        <% end %>
      <% else %><li class="list-group-item text-muted">No staff assigned yet.</li><% end %>
    </ul>
  </div>

  <% if can?("sales.view") %>
  <div class="card">
    <div class="card-header bg-transparent fw-semibold">Latest sales</div>
    <ul class="list-group list-group-flush">
      <% if @recent_sales.any? %>
        <% @recent_sales.each do |sale| %>
          <li class="list-group-item d-flex justify-content-between">
            <span><%= sale.sale_no %> &middot; <%= sale.customer&.name %></span>
            <span><%= number_to_currency(sale.total_amount) %> &middot; <%= sale.sale_date %></span>
          </li>
        <% end %>
      <% else %><li class="list-group-item text-muted">No sales in this branch.</li><% end %>
    </ul>
  </div>
  <% end %>
</div>
