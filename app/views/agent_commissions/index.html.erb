<%= page_header "Agent Commissions", subtitle: "Commission earned and paid out to sales agents", icon: "bi-percent" do %>
  <%= permitted_link_to new_agent_commission_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i>Record Commission<% end %>
<% end %>

<div class="row g-3 mb-3">
  <% [["Earned", money(@totals[:earned]), "bi-coin"], ["Paid", money(@totals[:paid]), "bi-check2-circle"], ["Pending", money(@totals[:pending]), "bi-hourglass-split"], ["Awaiting payout", @totals[:unpaid_count].to_s, "bi-people"]].each do |(label, value, icon)| %>
    <div class="col-md-3 col-xl-3"><div class="card"><div class="card-body d-flex align-items-center gap-3">
      <div class="rounded-circle bg-secondary-subtle text-secondary p-2"><i class="bi <%= icon %>"></i></div>
      <div><div class="text-muted small"><%= label %></div><div class="fs-5 fw-semibold"><%= value %></div></div>
    </div></div></div>
  <% end %>
</div>

<div class="card">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="fw-semibold small text-secondary"><%= @commissions.size %> commission(s)</span>
    <%= permitted_form_with url: agent_commissions_path, method: :get, local: true, class: "d-flex gap-2 flex-wrap qm-toolbar" do %>
      <%= select_tag :agent_id, options_for_select([["All agents", ""]] + @agents.map { |a| [a.name, a.id] }, params[:agent_id]), class: "form-select form-select-sm" %>
      <%= select_tag :status, options_for_select([["All statuses", ""], %w[Pending pending], %w[Partial partial], %w[Paid paid]], params[:status]), class: "form-select form-select-sm" %>
      <%= submit_tag "Filter", class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>Agent</th><th>Customer</th><th>Account No</th><th>Product</th><th>Sale No</th><th>Sale Date</th><th class="text-end">Commission Earned</th><th class="text-end">Amount Paid</th><th class="text-end">Balance</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        <% @commissions.each do |commission| %>
          <tr>
            <td><%= permitted_link_to commission.agent.name, agent_path(commission.agent) %></td>
            <td><%= commission.sale&.customer ? permitted_link_to(commission.sale.customer.display_name, customer_path(commission.sale.customer)) : "—" %></td>
            <td><%= tag.code(commission.sale&.customer&.account_no) %></td>
            <td class="small"><%= commission.sale&.vehicle_label.presence || "—" %></td>
            <td><%= commission.sale ? permitted_link_to(commission.sale.sale_no, sale_path(commission.sale)) : "—" %></td>
            <td><%= qm_date(commission.sale_date) %></td>
            <td class="text-end"><%= money(commission.earned_amount) %></td>
            <td class="text-end"><%= money(commission.paid_amount) %></td>
            <td class="text-end fw-semibold"><%= money(commission.balance) %></td>
            <td><%= status_badge(commission.status) %></td>
            <td class="text-end"><%= permitted_link_to agent_commission_path(commission), class: "btn btn-sm btn-outline-secondary" do %><i class="bi bi-eye"></i><% end %></td>
          </tr>
        <% end %>
        <% if @commissions.empty? %>
          <tr><td colspan="11" class="text-center text-muted py-4">No commissions recorded.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
