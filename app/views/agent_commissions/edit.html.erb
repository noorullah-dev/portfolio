<%= page_header "Edit Commission", subtitle: "Commission earned by #{@commission.agent.name}", icon: "bi-pencil" do %>
  <%= permitted_link_to "Back", agent_commissions_path, class: "btn btn-light" %>
<% end %>

<%= permitted_form_with model: @commission, url: agent_commission_path(@commission), method: :patch, local: true do |f| %>
  <% if @commission.errors.any? %>
    <div class="alert alert-danger"><%= @commission.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="card"><div class="card-body">
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label">Agent *</label>
        <%= f.select :agent_id, @agents.map { |a| [a.name, a.id] }, { include_blank: "Select agent" }, class: "form-select" %>
      </div>
      <div class="col-md-5">
        <label class="form-label">Against sale</label>
        <%= f.select :sale_id, @sales.map { |s| ["#{s.sale_no} — #{s.customer.display_name} (#{money(s.total_amount)})", s.id] }, { include_blank: "—" }, class: "form-select", id: "commission_sale" %>
      </div>
      <div class="col-md-3"><label class="form-label">Sale date</label><%= f.date_field :sale_date, class: "form-control" %></div>
      <div class="col-md-4"><label class="form-label">Basis amount</label><%= f.number_field :basis_amount, step: "0.01", min: 0, class: "form-control" %></div>
      <div class="col-md-4">
        <label class="form-label">Commission type</label>
        <%= f.select :commission_type, [%w[Percent percent], %w[Fixed fixed]], {}, class: "form-select", id: "commission_type" %>
      </div>
      <div class="col-md-4">
        <label class="form-label">Rate (percent or fixed amount)</label>
        <%= f.number_field :commission_value, step: "0.01", min: 0, class: "form-control" %>
      </div>
      <div class="col-md-4">
        <label class="form-label">Status</label>
        <%= f.select :status, %w[pending partial paid], {}, class: "form-select" %>
      </div>
    </div>
    <p class="text-muted small mb-0 mt-3"><i class="bi bi-info-circle me-1"></i>Earned amount is recalculated on save from the basis and the rate.</p>
  </div>
  <div class="card-footer bg-white d-flex justify-content-between">
    <%= permitted_link_to "Cancel", agent_commissions_path, class: "btn btn-light" %>
    <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i>Record commission</button>
  </div></div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var sale = document.getElementById("commission_sale");
    var basis = document.querySelector("[name='agent_commission[basis_amount]']");
    if (!sale || !basis) return;
    sale.addEventListener("change", function () {
      var option = sale.options[sale.selectedIndex];
      if (!option || !option.value) return;
      var match = option.textContent.match(/\(([^()]*)\)/);
      if (match) basis.value = match[1];
    });
  });
</script>
